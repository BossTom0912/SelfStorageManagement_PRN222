@*
    Partial hiển thị thông báo thành công / thất bại / cảnh báo / thông tin từ TempData
    Hỗ trợ cả tên khóa đầy đủ (SuccessMessage) và khóa ngắn gọn (Success).
*@

@{
    var successMsg = TempData["SuccessMessage"] as string ?? TempData["Success"] as string;
    var errorMsg = TempData["ErrorMessage"] as string ?? TempData["Error"] as string;
    var warningMsg = TempData["WarningMessage"] as string ?? TempData["Warning"] as string;
    var infoMsg = TempData["InfoMessage"] as string ?? TempData["Info"] as string;
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
        <div class="d-flex align-items-center">
            <span class="me-2 fs-5 text-success fw-bold">&#10004;</span>
            <div>
                <strong>Thành công:</strong> @successMsg
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
        <div class="d-flex align-items-center">
            <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
            <div>
                <strong>Lỗi:</strong> @errorMsg
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!string.IsNullOrEmpty(warningMsg))
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-3" role="alert">
        <div class="d-flex align-items-center">
            <span class="me-2 fs-5 text-warning fw-bold">&#9888;</span>
            <div>
                <strong>Cảnh báo:</strong> @warningMsg
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

@if (!string.IsNullOrEmpty(infoMsg))
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm mb-3" role="alert">
        <div class="d-flex align-items-center">
            <span class="me-2 fs-5 text-info fw-bold">&#8505;</span>
            <div>
                <strong>Thông tin:</strong> @infoMsg
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
