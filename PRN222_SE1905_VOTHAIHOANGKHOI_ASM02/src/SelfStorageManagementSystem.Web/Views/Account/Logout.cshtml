@{
    ViewData["Title"] = "Xác Nhận Đăng Xuất";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5 text-center">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                <div class="text-warning display-4 mb-3">&#9888;</div>
                <h4 class="fw-bold mb-3">Xác Nhận Đăng Xuất</h4>
                <p class="text-secondary mb-4">
                    Quý khách đang đăng nhập với tài khoản <strong>@User.Identity?.Name</strong>.<br />
                    Quý khách có chắc chắn muốn kết thúc phiên làm việc và đăng xuất không?
                </p>

                <form method="post" asp-action="Logout" class="d-inline-block w-100">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-danger btn-lg fs-6 py-2 fw-semibold">
                            Xác Nhận Đăng Xuất
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary py-2">
                            Hủy Bỏ &bull; Quay Về Trang Chủ
                        </a>
                    </div>
                </form>

                <div class="alert alert-info py-2 px-3 small text-start mt-3 mb-0">
                    <span class="fw-semibold">&#9432; Lưu ý bảo mật:</span> Đăng xuất chỉ được thực hiện qua phương thức POST kèm mã xác thực chống giả mạo (Antiforgery) để bảo vệ tài khoản khỏi các tấn công CSRF.
                </div>
            </div>
        </div>
    </div>
</div>
