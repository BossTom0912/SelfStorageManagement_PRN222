@page "/Reservations/Create"
@model SelfStorageManagementSystem.Web.Pages.Reservations.CreateModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Đặt Giữ Chỗ Kho";
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Reservations">Đặt chỗ của tôi</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tạo đơn giữ chỗ</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Tạo Đơn Giữ Chỗ Kho Mới</h1>
            <p class="text-muted mb-0">Hệ thống sẽ tạm giữ sức chứa khả dụng trong <strong>15 phút</strong> (quy tắc BR-RSV-01).</p>
        </div>
        <a href="/Catalog" class="btn btn-outline-secondary btn-sm">
            &larr; Xem danh mục kho
        </a>
    </div>

    <partial name="_AlertMessages" />
    <partial name="_ValidationSummary" />

    <div class="row g-4">
        <!-- Cột trái: Biểu mẫu nhập liệu -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-primary">Thông Tin Đơn Đặt Chỗ</h5>
                </div>
                <div class="card-body p-4">
                    <form method="post" id="createReservationForm">
                        <input type="hidden" asp-for="Input.FacilityId" />
                        <input type="hidden" asp-for="Input.UnitTypeId" />

                        <!-- Thông tin cơ sở và loại kho đã chọn -->
                        <div class="bg-light p-3 rounded mb-4 border">
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Cơ sở lưu trữ:</small>
                                    <strong class="text-dark">@(Model.Facility?.Name ?? $"Cơ sở ID #{Model.Input.FacilityId}")</strong>
                                    <div class="small text-muted font-monospace">@(Model.Facility?.Code ?? $"FAC-{Model.Input.FacilityId}")</div>
                                </div>
                                <div class="col-sm-6">
                                    <small class="text-muted d-block">Loại kho:</small>
                                    <strong class="text-dark">@(Model.UnitType?.Name ?? $"Loại kho ID #{Model.Input.UnitTypeId}")</strong>
                                    <div class="small text-muted">
                                        @if (Model.UnitType != null)
                                        {
                                            <span>@Model.UnitType.AreaM2?.ToString("0.##") m²</span>
                                            @if (Model.UnitType.ClimateControlled)
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">Có điều hòa</span>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Ngày thuê -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Input.RentalStartDate" class="form-label fw-semibold">
                                    Ngày bắt đầu thuê <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.RentalStartDate" type="date" class="form-control"
                                       min="@Model.MinStartDate.ToString("yyyy-MM-dd")" required id="rentalStartDateInput" />
                                <span asp-validation-for="Input.RentalStartDate" class="text-danger small"></span>
                                <div class="form-text small">Không được chọn ngày trong quá khứ.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.RentalEndDate" class="form-label fw-semibold">
                                    Ngày kết thúc thuê <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.RentalEndDate" type="date" class="form-control"
                                       min="@Model.MinEndDate.ToString("yyyy-MM-dd")"
                                       max="@Model.MaxEndDate.ToString("yyyy-MM-dd")" required id="rentalEndDateInput" />
                                <span asp-validation-for="Input.RentalEndDate" class="text-danger small"></span>
                                <div class="form-text small">Thời hạn thuê từ 1 đến 12 tháng (BR-RSV-02).</div>
                            </div>
                        </div>

                        <!-- Quy tắc giữ chỗ -->
                        <div class="alert alert-warning-subtle border border-warning-subtle small mb-4">
                            <div class="d-flex gap-2">
                                <span class="fw-bold fs-5 text-warning">&#9888;</span>
                                <div>
                                    <strong>Quy tắc tạm giữ sức chứa:</strong>
                                    Sau khi gửi yêu cầu thành công, hệ thống sẽ giữ chỗ cho bạn đúng <strong>15 phút</strong>.
                                    Nếu quá 15 phút chưa hoàn tất thanh toán, đơn sẽ tự động chuyển sang <em>Hết hạn</em> và sức chứa được giải phóng cho khách hàng khác.
                                </div>
                            </div>
                        </div>

                        <!-- Nút gửi yêu cầu -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a href="/Catalog" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary fw-semibold px-4" id="btnSubmitReservation">
                                Xác nhận giữ chỗ ngay &rarr;
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Bảng dự tính chi phí & Quy chuẩn -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-dark">Dự Tính Báo Giá Kỳ Đầu</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.UnitType != null)
                    {
                        var monthlyRate = Model.UnitType.MonthlyRate;
                        var deposit = Model.UnitType.DepositAmount > 0 ? Model.UnitType.DepositAmount : monthlyRate;
                        var bookingFee = Model.UnitType.BookingFee;
                        var total = monthlyRate + deposit + bookingFee;

                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>Giá thuê tháng đầu</span>
                                <span class="fw-semibold font-monospace">@AppFormatters.FormatVnd(monthlyRate)</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <span>Tiền đặt cọc</span>
                                    <div class="small text-muted">100% giá thuê 1 tháng (BR-FIN-01)</div>
                                </div>
                                <span class="fw-semibold font-monospace">@AppFormatters.FormatVnd(deposit)</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span>Phí giữ chỗ ban đầu</span>
                                <span class="fw-semibold font-monospace">
                                    @(bookingFee > 0 ? AppFormatters.FormatVnd(bookingFee) : "Miễn phí")
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 pt-3 border-top border-2">
                                <span class="h6 fw-bold mb-0">Tổng thanh toán dự kiến</span>
                                <span class="h5 fw-bold text-primary font-monospace mb-0">@AppFormatters.FormatVnd(total)</span>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            Vui lòng chọn cơ sở và loại kho hợp lệ để xem bảng dự tính chi phí.
                        </div>
                    }

                    <div class="bg-light p-3 rounded small text-muted border">
                        <div class="fw-semibold text-dark mb-1">&#8505; Quy chuẩn phân bổ ô kho (BR-RSV-03):</div>
                        Đơn đặt chỗ giữ chỗ theo <strong>Sức chứa loại kho</strong>. Mã ô kho cụ thể sẽ được nhân viên quầy tiếp nhận và bàn giao tại thời điểm Check-in trực tiếp tại cơ sở.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const startInput = document.getElementById('rentalStartDateInput');
            const endInput = document.getElementById('rentalEndDateInput');

            /**
             * Cộng tháng chuẩn hóa khớp hoàn toàn với DateOnly.AddMonths của C# .NET.
             * Kẹp ngày cuối tháng chính xác (ví dụ: 31/01/2026 + 1 tháng -> 28/02/2026 thay vì 03/03/2026 do Date.setMonth).
             */
            function addMonthsClamped(dateStr, monthsToAdd) {
                if (!dateStr) return '';
                const parts = dateStr.split('-');
                if (parts.length !== 3) return '';
                const year = parseInt(parts[0], 10);
                const month = parseInt(parts[1], 10);
                const day = parseInt(parts[2], 10);

                if (isNaN(year) || isNaN(month) || isNaN(day)) return '';

                const totalMonths = (year * 12 + (month - 1)) + monthsToAdd;
                const targetYear = Math.floor(totalMonths / 12);
                const targetMonth = (totalMonths % 12) + 1;

                // Ngày tối đa trong targetMonth của targetYear (ngày 0 của tháng kế tiếp = ngày cuối tháng này)
                const daysInTargetMonth = new Date(targetYear, targetMonth, 0).getDate();
                const targetDay = Math.min(day, daysInTargetMonth);

                const pad = (n) => String(n).padStart(2, '0');
                return `${targetYear}-${pad(targetMonth)}-${pad(targetDay)}`;
            }

            function syncDateLimits() {
                if (!startInput || !endInput || !startInput.value) return;

                const minEnd = addMonthsClamped(startInput.value, 1);
                const maxEnd = addMonthsClamped(startInput.value, 12);

                if (minEnd && maxEnd) {
                    endInput.min = minEnd;
                    endInput.max = maxEnd;

                    if (!endInput.value || endInput.value < minEnd || endInput.value > maxEnd) {
                        endInput.value = minEnd;
                    }
                }
            }

            if (startInput && endInput) {
                startInput.addEventListener('change', syncDateLimits);
                syncDateLimits();
            }
        });
    </script>
}
