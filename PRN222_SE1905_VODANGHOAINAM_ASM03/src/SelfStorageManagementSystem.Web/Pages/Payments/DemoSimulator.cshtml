@page "/Payments/DemoSimulator"
@model SelfStorageManagementSystem.Web.Pages.Payments.DemoSimulatorModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Demo Payment Gateway Simulator";
    var p = Model.Payment;
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Payments">Thanh toán</a></li>
            <li class="breadcrumb-item active" aria-current="page">Demo Simulator</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-danger">&#9888;</span>
                <div>
                    <strong>Lỗi:</strong> @Model.ErrorMessage
                </div>
            </div>
            <div class="mt-2">
                <a href="/Reservations" class="btn btn-outline-secondary btn-sm">Quay về danh sách đặt chỗ</a>
            </div>
        </div>
    }

    @if (p != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow border-0 overflow-hidden" style="border-radius: 16px;">
                    <!-- Header cổng thanh toán Demo -->
                    <div class="card-header bg-dark text-white p-4 text-center">
                        <div class="display-6 mb-2">🏦</div>
                        <h4 class="fw-bold mb-1">Cổng Thanh Toán Giả Lập</h4>
                        <div class="text-info small font-monospace">Demo Payment Gateway &bull; PRN222 Web</div>
                    </div>

                    <div class="card-body p-4">
                        <!-- Thông báo chế độ Web độc lập -->
                        <div class="alert alert-info border small mb-4">
                            <strong>⚡ Môi trường Thử nghiệm (Development/Test):</strong><br>
                            Thao tác trực tiếp trên giao diện Web với Cookie xác thực & Antiforgery Token.
                            Giao dịch được mô phỏng và xác nhận trực tiếp ngay trong trình duyệt web.
                        </div>

                        <!-- Chi tiết giao dịch -->
                        <div class="bg-light p-3 rounded mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Mã giao dịch (Payment ID):</span>
                                <span class="font-monospace fw-bold text-dark">#@p.PaymentId</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Đơn đặt chỗ:</span>
                                <span class="badge bg-secondary font-monospace">@p.ReservationCode</span>
                            </div>
                            @if (p.HoldUntil.HasValue)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Hạn giữ chỗ (Hold Until):</span>
                                    <span class="font-monospace small text-primary fw-semibold">
                                        @AppFormatters.FormatDateTimeSeconds(p.HoldUntil.Value)
                                    </span>
                                </div>
                            }
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark">Số tiền thanh toán:</span>
                                <span class="fs-4 fw-bold text-primary font-monospace">
                                    @AppFormatters.FormatVnd(p.Amount)
                                </span>
                            </div>
                        </div>

                        @if (p.Status == "succeeded")
                        {
                            <div class="alert alert-success text-center py-3">
                                <h5 class="fw-bold mb-1">&#10004; Giao dịch đã thanh toán thành công</h5>
                                <p class="small mb-3">Thanh toán này đã được xác nhận vào lúc @AppFormatters.FormatDateTime(p.PaidAt).</p>
                                <a href="/Payments/Result?paymentId=@p.PaymentId" class="btn btn-success fw-bold">
                                    Xem kết quả giao dịch
                                </a>
                            </div>
                        }
                        else if (p.Status == "failed" || p.Status == "cancelled")
                        {
                            <div class="alert alert-danger text-center py-3">
                                <h5 class="fw-bold mb-1">&#10008; Giao dịch đã kết thúc (Thất bại)</h5>
                                <p class="small mb-3">Lý do: @(p.FailureReason ?? "Đã hủy hoặc thất bại trước đó.")</p>
                                <a href="/Payments/Checkout?reservationId=@p.ReservationId" class="btn btn-outline-danger btn-sm">
                                    Tạo phiên thanh toán mới (Thử lại)
                                </a>
                            </div>
                        }
                        else
                        {
                            <!-- Form giả lập hành động hoàn tất -->
                            <form method="post" asp-page-handler="Complete" id="demoForm">
                                <input type="hidden" name="PaymentId" value="@p.PaymentId" />

                                <div class="mb-3">
                                    <label class="form-label fw-bold text-dark small">Chọn Kịch Bản Thử Nghiệm:</label>
                                    <div class="form-check p-3 border rounded mb-2 bg-white">
                                        <input class="form-check-input" type="radio" name="IsSuccess" id="radioSuccess" 
                                               value="true" checked onchange="toggleFailureFields(false)">
                                        <label class="form-check-label d-block cursor-pointer" for="radioSuccess">
                                            <strong class="text-success">&#10004; Giả Lập Thành Công (Demo Success)</strong>
                                            <div class="text-muted small">Cổng thanh toán xác nhận trừ tiền thành công. Hợp đồng chuyển sang trạng thái <em>scheduled</em>.</div>
                                        </label>
                                    </div>
                                    <div class="form-check p-3 border rounded bg-white">
                                        <input class="form-check-input" type="radio" name="IsSuccess" id="radioFailure" 
                                               value="false" onchange="toggleFailureFields(true)">
                                        <label class="form-check-label d-block cursor-pointer" for="radioFailure">
                                            <strong class="text-danger">&#10008; Giả Lập Thất Bại (Demo Failure)</strong>
                                            <div class="text-muted small">Cổng thanh toán báo lỗi (số dư không đủ, khách hủy...). Giao dịch kết thúc thất bại.</div>
                                        </label>
                                    </div>
                                </div>

                                <!-- Lý do thất bại (chỉ hiện khi chọn Thất bại) -->
                                <div class="mb-3 d-none" id="failureReasonContainer">
                                    <label class="form-label fw-bold text-dark small" for="failureReasonSelect">Lý Do Thất Bại:</label>
                                    <select class="form-select form-select-sm" name="FailureReason" id="failureReasonSelect">
                                        <option value="Tài khoản không đủ số dư để thanh toán.">Tài khoản không đủ số dư để thanh toán</option>
                                        <option value="Khách hàng hủy giao dịch tại cổng thanh toán.">Khách hàng hủy giao dịch tại cổng thanh toán</option>
                                        <option value="Thẻ/Tài khoản chưa đăng ký dịch vụ thanh toán trực tuyến.">Thẻ/Tài khoản chưa đăng ký Internet Banking</option>
                                        <option value="Lỗi đường truyền kết nối ngân hàng phát hành.">Lỗi đường truyền kết nối ngân hàng phát hành</option>
                                    </select>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label text-muted small" for="txtProviderTxnId">Mã Giao Dịch Nhà Cung Cấp (Tùy chọn):</label>
                                    <input type="text" class="form-control form-control-sm font-monospace" id="txtProviderTxnId"
                                           name="ProviderTransactionId" placeholder="Để trống để hệ thống tự sinh DEMO-TXN-..." maxlength="50" />
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary fw-bold py-3 shadow-sm fs-5" id="btnSubmitDemoComplete">
                                        &#9889; Xác Nhận Thao Tác Giả Lập
                                    </button>
                                    <a href="/Payments/Checkout?reservationId=@p.ReservationId" class="btn btn-outline-secondary btn-sm">
                                        Quay lại trang Checkout
                                    </a>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleFailureFields(isFailure) {
            var container = document.getElementById('failureReasonContainer');
            if (container) {
                if (isFailure) {
                    container.classList.remove('d-none');
                } else {
                    container.classList.add('d-none');
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('demoForm');
            var submitBtn = document.getElementById('btnSubmitDemoComplete');
            if (form && submitBtn) {
                form.addEventListener('submit', function (e) {
                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return false;
                    }
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý kết quả demo...';
                });
            }
        });
    </script>
}
