@*
    Partial hiển thị tổng hợp lỗi dữ liệu đầu vào (Validation Summary)
    Chỉ hiển thị khi có lỗi trong ModelState.
*@

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger shadow-sm mb-3" role="alert">
        <div class="d-flex align-items-center mb-2">
            <span class="me-2 fs-5 fw-bold">&#9888;</span>
            <strong class="fs-6">Vui lòng kiểm tra và sửa các lỗi nhập liệu dưới đây:</strong>
        </div>
        <div asp-validation-summary="All" class="text-danger small mb-0 ps-3"></div>
    </div>
}
