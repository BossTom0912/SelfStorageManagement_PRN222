@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<StorageUnitManager> Logger

<h1>Quản trị ô kho Blazor</h1>
<p class="text-muted">Tìm kiếm, phân trang và quản lý ô kho theo quyền tại cơ sở của bạn.</p>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
}

<fieldset disabled="@(_busy || !_interactive)">
    <form @onsubmit="SearchAsync" @onsubmit:preventDefault class="row g-3 mb-3">
        <div class="col-md-4">
            <label for="blazor-search" class="form-label">Tìm mã ô kho</label>
            <input id="blazor-search" class="form-control" @bind="_search" maxlength="100" />
        </div>
        <div class="col-md-4">
            <label for="blazor-facility" class="form-label">Cơ sở</label>
            <select id="blazor-facility" class="form-select" @bind="_facilityId">
                <option value="">Tất cả cơ sở được phép</option>
                @foreach (var facility in _facilities.Facilities)
                {
                    <option value="@facility.Id">@facility.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4 align-self-end d-flex gap-2">
            <button class="btn btn-primary" type="submit">Tìm kiếm</button>
            @if (_canManage)
            {
                <button class="btn btn-outline-primary" type="button" @onclick="StartCreateAsync">Thêm ô kho</button>
            }
        </div>
    </form>

    @if (_create is not null)
    {
        <EditForm Model="_create" OnValidSubmit="CreateAsync" class="card card-body mb-3">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <h2 class="h5">Thêm ô kho</h2>
            <label for="blazor-create-facility" class="form-label">Cơ sở</label>
            <InputSelect id="blazor-create-facility" class="form-select mb-2" @bind-Value="_create.FacilityId" @bind-Value:after="LoadCreateLookupsAsync">
                @foreach (var facility in _facilities.Facilities)
                {
                    <option value="@facility.Id">@facility.Name</option>
                }
            </InputSelect>
            <label for="blazor-create-type" class="form-label">Loại kho</label>
            <InputSelect id="blazor-create-type" class="form-select mb-2" @bind-Value="_create.UnitTypeId">
                <option value="0">Chọn loại kho</option>
                @foreach (var unitType in _lookups.UnitTypes)
                {
                    <option value="@unitType.Id">@unitType.Name</option>
                }
            </InputSelect>
            <label for="blazor-create-code" class="form-label">Mã ô kho</label>
            <InputText id="blazor-create-code" class="form-control mb-2" @bind-Value="_create.UnitCode" />
            <label for="blazor-create-notes" class="form-label">Ghi chú</label>
            <InputTextArea id="blazor-create-notes" class="form-control mb-2" @bind-Value="_create.Notes" />
            <div><button class="btn btn-primary" type="submit">Tạo ô kho</button> <button class="btn btn-secondary" type="button" @onclick="CancelEditor">Hủy</button></div>
        </EditForm>
    }

    @if (_edit is not null)
    {
        <EditForm Model="_edit" OnValidSubmit="SaveAsync" class="card card-body mb-3">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <h2 class="h5">Sửa ô kho</h2>
            <label for="blazor-edit-code" class="form-label">Mã ô kho</label>
            <InputText id="blazor-edit-code" class="form-control mb-2" @bind-Value="_edit.UnitCode" />
            <label for="blazor-edit-notes" class="form-label">Ghi chú</label>
            <InputTextArea id="blazor-edit-notes" class="form-control mb-2" @bind-Value="_edit.Notes" />
            <div><button class="btn btn-primary" type="submit">Lưu thay đổi</button> <button class="btn btn-secondary" type="button" @onclick="CancelEditor">Hủy</button></div>
        </EditForm>
    }

    @if (_delete is not null)
    {
        <div class="alert alert-warning" role="alert">
            Xác nhận xóa ô kho <strong>@_delete.UnitCode</strong>? Các ô có dữ liệu liên quan sẽ được xử lý theo quy tắc nghiệp vụ.
            <button class="btn btn-danger ms-2" type="button" @onclick="DeleteAsync">Xác nhận xóa</button>
            <button class="btn btn-secondary" type="button" @onclick="CancelEditor">Hủy</button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped" id="blazor-storage-units">
            <thead><tr><th>Mã ô kho</th><th>Cơ sở</th><th>Loại kho</th><th>Trạng thái</th><th>Niêm yết</th><th>Thao tác</th></tr></thead>
            <tbody>
                @foreach (var unit in _units.Items)
                {
                    <tr @key="unit.Id" data-unit-code="@unit.UnitCode">
                        <td>@unit.UnitCode</td><td>@unit.FacilityName</td><td>@unit.UnitTypeName</td><td>@unit.PhysicalStatus</td><td>@(unit.IsListed ? "Có" : "Không")</td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" href="/StorageUnits/Details/@unit.Id">Chi tiết</a>
                            @if (_canManage)
                            {
                                <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => StartEditAsync(unit)">Sửa</button>
                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => StartDelete(unit)">Xóa</button>
                            }
                        </td>
                    </tr>
                }
                @if (_units.Items.Count == 0)
                {
                    <tr><td colspan="6">Không có ô kho phù hợp.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex gap-3 align-items-center">
        <button class="btn btn-outline-secondary" type="button" disabled="@(!_units.HasPreviousPage)" @onclick="PreviousAsync">Trang trước</button>
        <span id="blazor-page-status">Trang @_units.PageNumber / @Math.Max(1, _units.TotalPages) · @_units.TotalCount ô kho</span>
        <button class="btn btn-outline-secondary" type="button" disabled="@(!_units.HasNextPage)" @onclick="NextAsync">Trang sau</button>
    </div>
</fieldset>

@code {
    private bool _busy, _canManage, _isError, _interactive;
    private string? _message, _search;
    private long? _facilityId;
    private int _page = 1;
    private long _editId;
    private PagedResult<StorageUnitAdminDto> _units = new();
    private StorageUnitLookupsDto _facilities = new(), _lookups = new();
    private CreateStorageUnitRequest? _create;
    private UpdateStorageUnitRequest? _edit;
    private StorageUnitAdminDto? _delete;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }
    }

    protected override Task OnInitializedAsync() => RunAsync(async (service, actor) =>
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canManage = user.IsInRole(RoleConstants.FacilityManager) || user.IsInRole(RoleConstants.BusinessOperationsManager) || user.IsInRole(RoleConstants.SystemAdministrator);
        _facilities = await service.GetLookupsAsync(actor);
        await LoadAsync(service, actor);
    });

    // Each event has its own scope. A circuit must not share a tracked DbContext across events.
    private async Task RunAsync(Func<IStorageUnitKhoiVTHService, long, Task> action)
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        _isError = false;
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            if (user.Identity?.IsAuthenticated != true || !long.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var actor))
                throw new UnauthorizedException("Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.");
            await using var scope = ScopeFactory.CreateAsyncScope();
            await action(scope.ServiceProvider.GetRequiredService<IStorageUnitKhoiVTHService>(), actor);
        }
        catch (Exception ex) when (ex is ForbiddenException or UnauthorizedException or BadRequestException or ConflictException or NotFoundException)
        {
            _isError = true;
            _message = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blazor storage unit operation failed.");
            _isError = true;
            _message = "Không thể hoàn tất thao tác. Vui lòng thử lại.";
        }
        finally { _busy = false; }
    }

    private async Task LoadAsync(IStorageUnitKhoiVTHService service, long actor)
    {
        _units = await service.ListAsync(new StorageUnitFilterRequest { FacilityId = _facilityId, SearchTerm = _search, PageNumber = _page, PageSize = 10 }, actor);
        if (_page > 1 && _units.Items.Count == 0)
        {
            _page = Math.Max(1, _units.TotalPages);
            _units = await service.ListAsync(new StorageUnitFilterRequest { FacilityId = _facilityId, SearchTerm = _search, PageNumber = _page, PageSize = 10 }, actor);
        }
    }

    private Task SearchAsync() { _page = 1; CancelEditor(); return RunAsync(LoadAsync); }
    private Task PreviousAsync() { if (_page > 1) _page--; return RunAsync(LoadAsync); }
    private Task NextAsync() { if (_units.HasNextPage) _page++; return RunAsync(LoadAsync); }
    private void CancelEditor() { _create = null; _edit = null; _delete = null; }
    private Task StartCreateAsync() => RunAsync(async (service, actor) =>
    {
        CancelEditor();
        _facilities = await service.GetLookupsAsync(actor);
        var facility = _facilityId ?? _facilities.Facilities.FirstOrDefault()?.Id;
        if (facility is null) throw new ForbiddenException("Bạn chưa có cơ sở được phép quản lý.");
        _lookups = await service.GetLookupsAsync(actor, facility);
        _create = new CreateStorageUnitRequest { FacilityId = facility.Value };
    });
    private Task LoadCreateLookupsAsync() => RunAsync(async (service, actor) =>
    {
        _create!.UnitTypeId = 0;
        _lookups = await service.GetLookupsAsync(actor, _create.FacilityId);
    });
    private Task CreateAsync() => RunAsync(async (service, actor) =>
    {
        var created = await service.CreateAsync(_create!, actor);
        CancelEditor();
        _facilityId = created.FacilityId;
        _page = 1;
        _search = created.UnitCode;
        await LoadAsync(service, actor);
        _message = "Đã tạo ô kho.";
    });
    private Task StartEditAsync(StorageUnitAdminDto unit) => RunAsync(async (service, actor) =>
    {
        var detail = await service.GetByIdAsync(unit.Id, actor) ?? throw new NotFoundException("Không tìm thấy ô kho.");
        CancelEditor();
        _editId = unit.Id;
        _edit = new UpdateStorageUnitRequest { UnitCode = detail.UnitCode, AreaId = detail.AreaId, FloorLabel = detail.FloorLabel, ZoneLabel = detail.ZoneLabel, Notes = detail.Notes, ExpectedUpdatedAt = detail.UpdatedAt };
    });
    private Task SaveAsync() => RunAsync(async (service, actor) =>
    {
        await service.UpdateAsync(_editId, _edit!, actor);
        CancelEditor();
        await LoadAsync(service, actor);
        _message = "Đã lưu thay đổi.";
    });
    private void StartDelete(StorageUnitAdminDto unit) { CancelEditor(); _delete = unit; }
    private Task DeleteAsync() => RunAsync(async (service, actor) =>
    {
        var result = await service.DeleteAsync(_delete!.Id, _delete.UpdatedAt, actor);
        CancelEditor();
        await LoadAsync(service, actor);
        _message = result.Message;
    });
}
