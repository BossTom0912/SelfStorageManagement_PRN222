@model SelfStorageManagementSystem.Web.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Lỗi Hệ Thống";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 text-center">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-5">
                <h1 class="display-4 text-danger fw-bold mb-3">500</h1>
                <h3 class="mb-3">Lỗi Xử Lý Yêu Cầu</h3>
                <p class="text-muted lead mb-4">@Model.Message</p>
                
                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-secondary d-inline-block text-start small mb-4">
                        <strong>Mã sự cố (Request ID):</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        &larr; Quay về Trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
