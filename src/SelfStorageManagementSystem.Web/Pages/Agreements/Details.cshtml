@page "/Agreements/Details/{id:long?}"
@model SelfStorageManagementSystem.Web.Pages.Agreements.DetailsModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = Model.Agreement != null
        ? $"Hợp Đồng {Model.Agreement.AgreementNo}"
        : "Chi Tiết Hợp Đồng Thuê Kho";
    var a = Model.Agreement;
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3 d-print-none">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Agreements">Hợp đồng thuê</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(a?.AgreementNo ?? "Chi tiết hợp đồng")</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-danger">&#9888;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <div class="mt-2">
                <a href="/Agreements" class="btn btn-outline-secondary btn-sm">Quay về danh sách hợp đồng</a>
            </div>
        </div>
    }
    else if (a != null)
    {
        <div class="card shadow-sm border-0 mb-4 bg-white" id="agreementPrintArea">
            <div class="card-body p-4 p-md-5">
                <!-- Header hợp đồng -->
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 border-bottom pb-4 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="brand-title fs-3 fw-bold text-dark">SelfStorage</span>
                            <span class="brand-accent fs-3 fw-bold text-primary">PRN222</span>
                        </div>
                        <div class="text-muted small">Cơ sở: <strong>@a.FacilityName</strong></div>
                        <div class="text-muted small">Hợp đồng dịch vụ kho lưu trữ tự quản</div>
                    </div>

                    <div class="text-md-end">
                        <div class="d-flex align-items-center justify-content-md-end gap-2 mb-1">
                            <h2 class="h4 fw-bold font-monospace mb-0 text-dark">@a.AgreementNo</h2>
                            @{
                                var statusClass = a.Status switch
                                {
                                    "active" => "badge bg-success",
                                    "scheduled" => "badge bg-warning text-dark",
                                    "terminated" => "badge bg-secondary",
                                    "expired" => "badge bg-danger",
                                    _ => "badge bg-info text-dark"
                                };
                            }
                            <span class="@statusClass px-3 py-1 fs-6">@a.Status.ToUpper()</span>
                        </div>
                        <div class="small text-muted">
                            Mã hợp đồng nội bộ: <span class="font-monospace">#@a.AgreementId</span>
                        </div>
                        <div class="small text-muted">
                            Thời điểm tạo: <strong>@AppFormatters.FormatDateTime(a.CreatedAt)</strong>
                        </div>
                    </div>
                </div>

                <!-- Thông báo nghiệp vụ Function 4 / Function 5 -->
                <div class="alert alert-light border small text-muted mb-4">
                    <strong>📌 Quy chuẩn vận hành:</strong> @a.Notice
                </div>

                <!-- Thông tin khách hàng & Thời hạn thuê -->
                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2">Bên Thuê (Khách Hàng):</h6>
                        <div class="fs-5 fw-bold text-dark mb-1">@a.CustomerName</div>
                        <div class="small text-muted">Mã khách hàng: <span class="font-monospace">#@a.CustomerId</span></div>
                        @if (!string.IsNullOrEmpty(a.PolicyVersion))
                        {
                            <div class="small text-muted">Phiên bản điều khoản: <span class="badge bg-light text-dark border font-monospace">rental_terms @a.PolicyVersion</span></div>
                        }
                    </div>

                    <div class="col-sm-6 text-sm-end">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2">Thời Gian Hiệu Lực:</h6>
                        <div class="small text-dark mb-1">
                            Bắt đầu: <strong>@AppFormatters.FormatDate(a.StartDate)</strong>
                        </div>
                        <div class="small text-dark mb-1">
                            Kết thúc: <strong>@AppFormatters.FormatDate(a.EndDate)</strong>
                        </div>
                        <div class="small">
                            Đơn đặt chỗ gốc:
                            <a href="/Reservations/Details/@a.ReservationId" class="badge bg-secondary font-monospace text-decoration-none">
                                @(a.ReservationCode ?? $"#{a.ReservationId}")
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Bảng điều khoản tài chính & Ô kho -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold text-dark mb-3">💰 Cam Kết Tài Chính (BR-FIN-01)</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Giá thuê hàng tháng:</span>
                                <span class="fw-bold text-dark font-monospace">@AppFormatters.FormatVnd(a.MonthlyRateSnapshot)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Tiền đặt cọc ban đầu (100% 1 tháng):</span>
                                <span class="fw-bold text-dark font-monospace">@AppFormatters.FormatVnd(a.DepositSnapshot)</span>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top">
                                <span class="text-dark small fw-semibold">Số dư tiền đặt cọc hiện tại:</span>
                                <span class="fw-bold text-success font-monospace">@AppFormatters.FormatVnd(a.DepositBalance)</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card bg-light border-0 p-3 h-100">
                            <h6 class="fw-bold text-dark mb-3">🚪 Ô Kho Được Gán (Storage Unit)</h6>
                            @if (a.IsStorageUnitAllocated)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Mã ô kho:</span>
                                    <span class="badge bg-primary fs-6 font-monospace">@a.StorageUnitCode</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">Thời điểm nhận kho:</span>
                                    <span class="small text-dark font-monospace">@AppFormatters.FormatDateTime(a.CheckedInAt)</span>
                                </div>
                                <div class="mt-2 text-end">
                                    <a href="/StorageUnits/Details?id=@a.StorageUnitId" class="btn btn-outline-primary btn-sm">
                                        Xem thông tin ô kho &rarr;
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-2">
                                    <div class="badge bg-warning-subtle text-dark border border-warning px-3 py-2 fs-6 mb-2">
                                        Chưa gán ô kho (Scheduled)
                                    </div>
                                    <p class="small text-muted mb-0">
                                        Ô kho và mã PIN mở khóa sẽ được cấp phát khi hoàn tất thủ tục bàn giao tại quầy tiếp nhận.
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Thao tác -->
                <div class="d-flex justify-content-between align-items-center d-print-none pt-3 border-top">
                    <a href="/Agreements" class="btn btn-outline-secondary btn-sm">
                        &larr; Danh sách hợp đồng
                    </a>
                    <div class="d-flex gap-2">
                        @if (User.IsInRole(RoleConstants.FacilityStaff) || User.IsInRole(RoleConstants.FacilityManager))
                        {
                            <a href="/Staff/CheckIn" class="btn btn-primary btn-sm fw-semibold">
                                📋 Đến quầy tiếp nhận check-in
                            </a>
                        }
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print();">
                            🖨 In hợp đồng
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
