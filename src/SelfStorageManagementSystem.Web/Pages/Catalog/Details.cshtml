@page "{facilityId:long?}"
@model SelfStorageManagementSystem.Web.Pages.Catalog.DetailsModel
@using SelfStorageManagementSystem.Web.Models
@{
    ViewData["Title"] = Model.Facility?.Name ?? "Chi Tiết Cơ Sở Kho";
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;

    string GetDisplayStatusText(string status) => status switch
    {
        "available" => "Sẵn sàng (Khả dụng)",
        "occupied" => "Đang thuê",
        "reserved" => "Khóa vật lý",
        "maintenance" => "Đang bảo trì",
        _ => "Không khả dụng"
    };
}

<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Catalog">Danh mục kho</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(Model.Facility?.Name ?? "Chi tiết cơ sở")</li>
        </ol>
    </nav>

    @if (Model.FacilityNotFound || Model.Facility == null)
    {
        <!-- Giao diện báo lỗi không tìm thấy cơ sở -->
        <partial name="_EmptyState" model='new EmptyStateViewModel
        {
            Title = "Không tìm thấy cơ sở kho",
            Message = Model.ErrorMessage ?? "Cơ sở lưu trữ không tồn tại hoặc hiện đang tạm ngừng phục vụ.",
            ActionText = "Quay lại danh mục kho",
            ActionUrl = "/Catalog"
        }' />
    }
    else
    {
        <!-- Khối thông tin chung cơ sở (Facility Header) -->
        <div class="card shadow-sm border-0 mb-4 bg-white">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-secondary font-monospace px-2 py-1">@Model.Facility.Code</span>
                            @if (Model.Facility.Status == "active")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    &#9679; Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                    @Model.Facility.Status
                                </span>
                            }
                        </div>
                        <h1 class="h3 fw-bold text-dark mb-2">@Model.Facility.Name</h1>
                        <p class="text-secondary mb-2">
                            <span class="me-1">&#128205;</span>
                            @Model.Facility.AddressLine@(string.IsNullOrWhiteSpace(Model.Facility.Ward) ? "" : $", {Model.Facility.Ward}"), @Model.Facility.District, @Model.Facility.City
                        </p>
                        <div class="d-flex flex-wrap gap-3 text-secondary small">
                            <div>
                                <span class="text-muted">Giờ mở cửa:</span>
                                <strong class="text-dark">
                                    @AppFormatters.FormatTime(Model.Facility.OpeningTime) &mdash; @AppFormatters.FormatTime(Model.Facility.ClosingTime)
                                </strong>
                            </div>
                            <div>
                                <span class="text-muted">Múi giờ:</span>
                                <span class="font-monospace text-dark">@Model.Facility.Timezone</span>
                            </div>
                            @if (Model.Facility.Latitude.HasValue && Model.Facility.Longitude.HasValue)
                            {
                                <div>
                                    <span class="text-muted">&#127758; GPS:</span>
                                    <span class="font-monospace text-dark">@Model.Facility.Latitude.Value.ToString("F4"), @Model.Facility.Longitude.Value.ToString("F4")</span>
                                    <a href="https://maps.google.com/?q=@Model.Facility.Latitude.Value,@Model.Facility.Longitude.Value" 
                                       target="_blank" rel="noopener noreferrer" class="ms-1 text-decoration-none">
                                        (Xem bản đồ &nearr;)
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a href="/Catalog" class="btn btn-outline-secondary btn-sm me-2">
                            &larr; Danh mục cơ sở
                        </a>
                        <a href="#tab-floor-map" class="btn btn-primary btn-sm" onclick="$('#tab-floor-map-nav').tab('show');">
                            Xem sơ đồ kho &darr;
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cảnh báo kiểm tra hợp lệ hoặc thông báo backend nếu có -->
        @if (!string.IsNullOrEmpty(Model.ValidationMessage))
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <span class="fs-4 me-2">&#9888;</span>
                    <div>@Model.ValidationMessage</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <span class="fs-4 me-2">&#9888;</span>
                    <div>@Model.ErrorMessage</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <!-- Thanh công cụ lọc ngày thuê và thuộc tính kho (Filter Bar) -->
        <div class="card catalog-filter-card mb-4">
            <div class="card-header bg-light py-2">
                <span class="fw-semibold small text-secondary">
                    <span class="me-1">&#128392;</span> Bộ Lọc Thời Gian Thuê &amp; Tiêu Chí Kho
                </span>
            </div>
            <div class="card-body p-3">
                <form method="get" action="/Catalog/Details" class="row g-2 align-items-end">
                    <input type="hidden" name="facilityId" value="@Model.Facility.Id" />
                    <input type="hidden" name="ActiveTab" value="@Model.ActiveTab" />

                    <div class="col-6 col-md-2">
                        <label for="filterStartDate" class="form-label small fw-semibold text-secondary mb-1">Ngày bắt đầu</label>
                        <input type="date" class="form-control form-control-sm" id="filterStartDate" name="RentalStartDate" 
                               value="@(Model.RentalStartDate?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="col-6 col-md-2">
                        <label for="filterEndDate" class="form-label small fw-semibold text-secondary mb-1">Ngày kết thúc</label>
                        <input type="date" class="form-control form-control-sm" id="filterEndDate" name="RentalEndDate" 
                               value="@(Model.RentalEndDate?.ToString("yyyy-MM-dd"))" required />
                    </div>

                    <div class="col-6 col-md-2">
                        <label for="filterMaxPrice" class="form-label small fw-semibold text-secondary mb-1">Giá tối đa (VND)</label>
                        <input type="number" class="form-control form-control-sm" id="filterMaxPrice" name="MaxPrice" 
                               value="@Model.MaxPrice" min="0" step="100000" placeholder="VD: 2000000" />
                    </div>

                    <div class="col-6 col-md-2">
                        <label for="filterMinArea" class="form-label small fw-semibold text-secondary mb-1">Diện tích min (m²)</label>
                        <input type="number" class="form-control form-control-sm" id="filterMinArea" name="MinAreaM2" 
                               value="@Model.MinAreaM2" min="0" step="0.5" placeholder="Min m²" />
                    </div>

                    <div class="col-6 col-md-2">
                        <label for="filterMaxArea" class="form-label small fw-semibold text-secondary mb-1">Diện tích max (m²)</label>
                        <input type="number" class="form-control form-control-sm" id="filterMaxArea" name="MaxAreaM2" 
                               value="@Model.MaxAreaM2" min="0" step="0.5" placeholder="Max m²" />
                    </div>

                    <div class="col-6 col-md-2">
                        <label for="filterClimate" class="form-label small fw-semibold text-secondary mb-1">Điều hòa / Nhiệt độ</label>
                        <select class="form-select form-select-sm" id="filterClimate" name="ClimateControlled">
                            <option value="">Tất cả</option>
                            <option value="true" selected="@(Model.ClimateControlled == true)">Có điều hòa</option>
                            <option value="false" selected="@(Model.ClimateControlled == false)">Không điều hòa</option>
                        </select>
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2 mt-3 pt-2 border-top">
                        <a href="/Catalog/Details?facilityId=@Model.Facility.Id" class="btn btn-outline-secondary btn-sm">
                            &#8635; Đặt lại bộ lọc
                        </a>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">
                            &#128269; Áp dụng lọc
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Khối Tabs chuyển đổi nội dung -->
        <ul class="nav nav-tabs mb-4" id="catalogDetailsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "unit-types" ? "active" : "") fw-semibold" 
                        id="tab-unit-types-nav" data-bs-toggle="tab" data-bs-target="#tab-unit-types" 
                        type="button" role="tab" aria-controls="tab-unit-types" aria-selected="@(Model.ActiveTab == "unit-types")">
                    Loại Kho &amp; Bảng Giá (@Model.UnitTypes.Count)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "floor-map" ? "active" : "") fw-semibold" 
                        id="tab-floor-map-nav" data-bs-toggle="tab" data-bs-target="#tab-floor-map" 
                        type="button" role="tab" aria-controls="tab-floor-map" aria-selected="@(Model.ActiveTab == "floor-map")">
                    Sơ Đồ Mặt Bằng Ô Kho
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "candidate-units" ? "active" : "") fw-semibold" 
                        id="tab-candidate-units-nav" data-bs-toggle="tab" data-bs-target="#tab-candidate-units" 
                        type="button" role="tab" aria-controls="tab-candidate-units" aria-selected="@(Model.ActiveTab == "candidate-units")">
                    Danh Sách Ô Ứng Viên (@Model.AvailableUnits.TotalCount)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "facility-info" ? "active" : "") fw-semibold" 
                        id="tab-facility-info-nav" data-bs-toggle="tab" data-bs-target="#tab-facility-info" 
                        type="button" role="tab" aria-controls="tab-facility-info" aria-selected="@(Model.ActiveTab == "facility-info")">
                    Thông Tin Cơ Sở
                </button>
            </li>
        </ul>

        <!-- Nội dung từng Tab -->
        <div class="tab-content" id="catalogDetailsTabContent">
            
            <!-- ========================================== -->
            <!-- TAB 1: LOẠI KHO & BẢNG GIÁ & SỨC CHỨA      -->
            <!-- ========================================== -->
            <div class="tab-pane fade @(Model.ActiveTab == "unit-types" ? "show active" : "")" 
                 id="tab-unit-types" role="tabpanel" aria-labelledby="tab-unit-types-nav">
                
                <div class="alert alert-info py-2 px-3 small mb-4 shadow-sm">
                    <strong>&#9432; Quy tắc đặt chỗ (BR-RSV-03):</strong>
                    Khách hàng thực hiện đặt chỗ theo <strong>Loại kho</strong>. Sức chứa khả dụng tham khảo được tính dựa trên số ô ứng viên trừ đi các đơn giữ chỗ đang chờ phân công. Ô kho vật lý cụ thể sẽ do nhân viên cơ sở chỉ định khi làm thủ tục nhận kho tại quầy.
                </div>

                @if (Model.UnitTypes.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyStateViewModel
                    {
                        Title = "Không có loại kho phù hợp với bộ lọc",
                        Message = "Hiện tại không có loại kho nào thỏa mãn khoảng giá hoặc tiêu chí diện tích bạn chọn. Hãy thử điều chỉnh lại bộ lọc.",
                        ActionText = "Xóa tiêu chí lọc",
                        ActionUrl = $"/Catalog/Details?facilityId={Model.Facility.Id}"
                    }' />
                }
                else
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                        @foreach (var type in Model.UnitTypes)
                        {
                            var isOutOfCapacity = type.EstimatedAvailableUnits <= 0;
                            <div class="col">
                                <div class="unit-type-card @(isOutOfCapacity ? "out-of-capacity" : "") shadow-sm">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                        <span class="badge bg-secondary font-monospace">@type.Code</span>
                                        @if (type.ClimateControlled)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                                &#10052; Có điều hòa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border">Thông thường</span>
                                        }
                                    </div>
                                    <div class="card-body">
                                        <h2 class="h5 fw-bold text-dark mb-2">@type.Name</h2>
                                        
                                        @if (!string.IsNullOrEmpty(type.Description))
                                        {
                                            <p class="text-secondary small mb-3">@type.Description</p>
                                        }

                                        <!-- Kích thước và thông số -->
                                        <div class="bg-light p-2 rounded mb-3 small">
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted">Kích thước (R &times; D &times; C):</span>
                                                <span class="fw-semibold">@type.WidthM.ToString("F1") &times; @type.LengthM.ToString("F1") &times; @type.HeightM.ToString("F1") m</span>
                                            </div>
                                            <div class="d-flex justify-content-between mb-1">
                                                <span class="text-muted">Diện tích / Thể tích:</span>
                                                <span class="fw-semibold">
                                                    @(type.AreaM2.HasValue ? $"{type.AreaM2.Value:F1} m²" : "—") / 
                                                    @(type.VolumeM3.HasValue ? $"{type.VolumeM3.Value:F1} m³" : "—")
                                                </span>
                                            </div>
                                            @if (type.MaxWeightKg.HasValue)
                                            {
                                                <div class="d-flex justify-content-between">
                                                    <span class="text-muted">Tải trọng tối đa:</span>
                                                    <span class="fw-semibold">@type.MaxWeightKg.Value.ToString("N0") kg</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- Biểu phí & Giá niêm yết -->
                                        <div class="border rounded p-2 mb-3 bg-white">
                                            <div class="d-flex justify-content-between align-items-baseline mb-1">
                                                <span class="text-muted small">Giá thuê tháng:</span>
                                                <span class="unit-type-price text-primary">
                                                    @AppFormatters.FormatVnd(type.MonthlyRate)
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                                <span>Tiền đặt cọc:</span>
                                                <span>@AppFormatters.FormatVnd(type.DepositAmount)</span>
                                            </div>
                                            <div class="d-flex justify-content-between small text-secondary mb-1">
                                                <span>Phí giữ chỗ:</span>
                                                <span>@AppFormatters.FormatVnd(type.BookingFee)</span>
                                            </div>
                                            <div class="text-muted small border-top pt-1 mt-1 text-end" style="font-size: 0.75rem;">
                                                Hiệu lực: @AppFormatters.FormatDate(type.RateValidFrom)@(type.RateValidTo.HasValue ? $" - {AppFormatters.FormatDate(type.RateValidTo.Value)}" : "")
                                            </div>
                                        </div>

                                        <!-- Sức chứa tham khảo trung thực -->
                                        <div class="mb-3">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="small fw-semibold text-secondary">Sức chứa khả dụng:</span>
                                                @if (type.EstimatedAvailableUnits > 0)
                                                {
                                                    <span class="badge bg-success">
                                                        @type.EstimatedAvailableUnits / @type.TotalListedUnits ô khả dụng
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        Tạm hết chỗ (0/@type.TotalListedUnits)
                                                    </span>
                                                }
                                            </div>
                                            <div class="form-text small text-muted fst-italic">
                                                @type.AvailabilityNote
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-white border-top">
                                        @if (type.EstimatedAvailableUnits > 0)
                                        {
                                            @if (isAuthenticated)
                                            {
                                                <a href="@Model.GetReservationUrl(type.UnitTypeId)" 
                                                   class="btn btn-primary w-100 fw-semibold">
                                                    Đặt chỗ loại kho này &rarr;
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@Model.GetReservationUrl(type.UnitTypeId)" 
                                                   class="btn btn-outline-primary w-100 fw-semibold">
                                                    Đăng nhập để đặt chỗ &rarr;
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary w-100 fw-semibold" disabled>
                                                Tạm hết sức chứa
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ========================================== -->
            <!-- TAB 2: SƠ ĐỒ MẶT BẰNG Ô KHO (Interactive)  -->
            <!-- ========================================== -->
            <div class="tab-pane fade @(Model.ActiveTab == "floor-map" ? "show active" : "")" 
                 id="tab-floor-map" role="tabpanel" aria-labelledby="tab-floor-map-nav">
                
                <div class="floor-map-wrapper">
                    <!-- Thanh điều khiển sơ đồ: Chọn tầng / khu vực & Thống kê -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <label for="floorMapAreaSelector" class="form-label fw-semibold text-secondary mb-0 text-nowrap">
                                Khu vực / Tầng:
                            </label>
                            <select id="floorMapAreaSelector" class="form-select form-select-sm" style="min-width: 180px;">
                                <option value="">Tất cả khu vực</option>
                                @if (Model.FloorMap?.Areas != null)
                                {
                                    @foreach (var area in Model.FloorMap.Areas)
                                    {
                                        <option value="@area.Id" selected="@(Model.SelectedAreaId == area.Id)">
                                            @area.Name (@area.Code)
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <span class="badge bg-light text-dark border">
                                Sơ đồ: <strong>@(Model.FloorMap?.TotalUnitsWithMap ?? 0)</strong> ô
                            </span>
                            @if ((Model.FloorMap?.TotalUnitsWithoutMap ?? 0) > 0)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" 
                                      title="Có @(Model.FloorMap?.TotalUnitsWithoutMap ?? 0) ô thuộc cơ sở này chưa được định vị tọa độ sơ đồ số">
                                    Chưa định vị: @(Model.FloorMap?.TotalUnitsWithoutMap ?? 0) ô
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Bảng chú giải trạng thái ô trên sơ đồ -->
                    <div class="floor-map-legend mb-3">
                        <div class="legend-item">
                            <span class="legend-color-box legend-box-available"></span>
                            <span>Sẵn sàng (Khả dụng)</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color-box legend-box-occupied"></span>
                            <span>Đang có hợp đồng thuê</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color-box legend-box-reserved"></span>
                            <span>Khóa trực tiếp vật lý</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color-box legend-box-maintenance"></span>
                            <span>Bảo trì kỹ thuật</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color-box legend-box-unavailable"></span>
                            <span>Ngừng niêm yết</span>
                        </div>
                    </div>

                    <!-- Lưu ý nghiệp vụ trung thực không bịa tọa độ -->
                    <div class="small text-muted mb-3 fst-italic">
                        * Sơ đồ kết xuất chính xác theo tọa độ thực tế đã được lưu trong cơ sở dữ liệu. Bấm vào một ô bất kỳ để xem thông tin chi tiết và liên kết đặt chỗ loại kho tương ứng.
                    </div>

                    <!-- Sơ đồ SVG hoặc Giao diện rỗng -->
                    @if (Model.FloorMap == null || Model.FloorMap.Units.Count == 0)
                    {
                        <partial name="_EmptyState" model='new EmptyStateViewModel
                        {
                            Title = "Chưa có sơ đồ mặt bằng",
                            Message = "Cơ sở này hiện chưa có dữ liệu sơ đồ mặt bằng được lưu trữ trong hệ thống.",
                            ActionText = "Xem danh mục loại kho",
                            ActionUrl = "#tab-unit-types"
                        }' />
                    }
                    else
                    {
                        // Tính toán bounding box cho SVG viewBox linh hoạt không bị méo
                        var minX = Model.FloorMap.Units.Min(u => u.X);
                        var minY = Model.FloorMap.Units.Min(u => u.Y);
                        var maxX = Model.FloorMap.Units.Max(u => u.X + u.Width);
                        var maxY = Model.FloorMap.Units.Max(u => u.Y + u.Height);
                        var padding = 15m;
                        var svgX = Math.Max(0, minX - padding);
                        var svgY = Math.Max(0, minY - padding);
                        var svgW = Math.Max(100m, (maxX - svgX) + padding);
                        var svgH = Math.Max(60m, (maxY - svgY) + padding);

                        <div class="row">
                            <!-- Khung chứa sơ đồ SVG -->
                            <div class="col-lg-8">
                                <div id="floorMapContainer" class="floor-map-container">
                                    <svg id="facilityFloorMapSvg" class="floor-map-svg" 
                                         viewBox="@svgX.ToString("F1") @svgY.ToString("F1") @svgW.ToString("F1") @svgH.ToString("F1")"
                                         xmlns="http://www.w3.org/2000/svg">
                                        
                                        <!-- Grid Pattern nền -->
                                        <defs>
                                            <pattern id="gridPattern" width="10" height="10" patternUnits="userSpaceOnUse">
                                                <path d="M 10 0 L 0 0 0 10" fill="none" stroke="#e2e8f0" stroke-width="0.5"/>
                                            </pattern>
                                        </defs>
                                        <rect x="@svgX.ToString("F1")" y="@svgY.ToString("F1")" 
                                              width="@svgW.ToString("F1")" height="@svgH.ToString("F1")" 
                                              fill="url(#gridPattern)" />

                                        <!-- Render từng ô kho trên sơ đồ -->
                                        @foreach (var unit in Model.FloorMap.Units)
                                        {
                                            var cx = unit.X + unit.Width / 2m;
                                            var cy = unit.Y + unit.Height / 2m;
                                            var transform = unit.RotationDegrees != 0 
                                                ? $"transform=\"rotate({unit.RotationDegrees.ToString(System.Globalization.CultureInfo.InvariantCulture)} {cx.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {cy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)})\"" 
                                                : "";
                                            var fontSize = Math.Max(2.5m, Math.Min(unit.Width, unit.Height) * 0.35m);

                                            <rect class="unit-rect unit-status-@unit.DisplayStatus @(unit.CanSelectToProceed ? "can-proceed" : "")"
                                                  x="@unit.X.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                                  y="@unit.Y.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                                  width="@unit.Width.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" 
                                                  height="@unit.Height.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                                  rx="1" ry="1"
                                                  @Html.Raw(transform)
                                                  data-unit-id="@unit.UnitId"
                                                  data-unit-code="@unit.UnitCode"
                                                  data-unit-type-id="@unit.UnitTypeId"
                                                  data-unit-type-name="@unit.UnitTypeName"
                                                  data-area-name="@unit.AreaName"
                                                  data-area-m2="@unit.AreaM2"
                                                  data-volume-m3="@unit.VolumeM3"
                                                  data-monthly-rate="@(unit.MonthlyRate.HasValue ? AppFormatters.FormatVnd(unit.MonthlyRate.Value) : "Chưa có biểu giá")"
                                                  data-status="@unit.DisplayStatus"
                                                  data-status-text="@GetDisplayStatusText(unit.DisplayStatus)"
                                                  data-can-proceed="@unit.CanSelectToProceed.ToString().ToLower()">
                                                <title>Ô @unit.UnitCode (@unit.UnitTypeName) - @GetDisplayStatusText(unit.DisplayStatus)</title>
                                            </rect>

                                            @:<text class="unit-label" x="@cx.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" y="@cy.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" text-anchor="middle" dominant-baseline="central" font-size="@fontSize.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" font-weight="600" @Html.Raw(transform)>@unit.UnitCode</text>
                                        }
                                    </svg>
                                </div>
                            </div>

                            <!-- Panel hiển thị chi tiết ô kho đang chọn -->
                            <div class="col-lg-4 mt-3 mt-lg-0">
                                <div id="unitDetailPanel" class="unit-detail-panel p-3 d-none shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                        <h3 class="h5 fw-bold text-dark mb-0">
                                            Ô kho: <span id="selectedUnitCode" class="text-primary font-monospace">—</span>
                                        </h3>
                                        <span id="selectedUnitStatusBadge" class="badge bg-success">Sẵn sàng</span>
                                    </div>
                                    <div class="small mb-3">
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Loại kho:</span>
                                            <span id="selectedUnitTypeName" class="fw-semibold text-dark">—</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Khu vực / Tầng:</span>
                                            <span id="selectedUnitAreaName" class="text-dark">—</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Diện tích (Thể tích):</span>
                                            <span id="selectedUnitDimensions" class="text-dark">—</span>
                                        </div>
                                        <div class="d-flex justify-content-between py-1 border-bottom">
                                            <span class="text-muted">Giá thuê niêm yết:</span>
                                            <span id="selectedUnitMonthlyRate" class="fw-bold text-primary">—</span>
                                        </div>
                                    </div>
                                    <div id="selectedUnitActionContainer">
                                        <!-- Nút đặt chỗ được JavaScript cập nhật động -->
                                    </div>
                                </div>

                                <div id="unitDetailPlaceholder" class="p-4 border rounded bg-light text-center text-muted small">
                                    <div class="fs-2 mb-2">&#128070;</div>
                                    <div class="fw-semibold">Chưa chọn ô kho nào</div>
                                    <div>Hãy nhấp vào một ô trên sơ đồ để tra cứu thông tin và tiến hành đặt chỗ.</div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Thẻ lưu cấu hình cho client script -->
                    <div id="mapConfigData" 
                         data-reserve-url-template="/Reservations?facilityId=@Model.Facility.Id&unitTypeId=__TYPE_ID__&rentalStartDate=@Model.RentalStartDate?.ToString("yyyy-MM-dd")&rentalEndDate=@Model.RentalEndDate?.ToString("yyyy-MM-dd")"
                         data-login-url-template="/Account/Login?returnUrl=__RETURN_URL__"
                         data-is-authenticated="@(isAuthenticated.ToString().ToLower())"
                         class="d-none"></div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- TAB 3: DANH SÁCH Ô ỨNG VIÊN KHẢ DỤNG       -->
            <!-- ========================================== -->
            <div class="tab-pane fade @(Model.ActiveTab == "candidate-units" ? "show active" : "")" 
                 id="tab-candidate-units" role="tabpanel" aria-labelledby="tab-candidate-units-nav">
                
                <div class="alert alert-secondary py-2 px-3 small mb-3">
                    <strong>&#9432; Ô ứng viên khả dụng:</strong>
                    Danh sách các ô kho vật lý đang ở trạng thái <code>available</code>, không vướng bảo trì và không bị trùng lịch thuê. Nhân viên quầy sẽ gán một trong các ô này khi khách hàng đến nhận kho.
                </div>

                @if (Model.AvailableUnits.Items.Count == 0)
                {
                    <partial name="_EmptyState" model='new EmptyStateViewModel
                    {
                        Title = "Không có ô kho ứng viên khả dụng",
                        Message = "Cơ sở này hiện không còn ô kho nào khả dụng cho khoảng thời gian hoặc tiêu chí lọc đã chọn.",
                        ActionText = "Xem danh mục loại kho",
                        ActionUrl = $"#tab-unit-types"
                    }' />
                }
                else
                {
                    <div class="table-responsive shadow-sm rounded border bg-white mb-3">
                        <table class="table table-hover table-candidate-units mb-0">
                            <thead>
                                <tr>
                                    <th>Mã ô</th>
                                    <th>Loại kho</th>
                                    <th>Khu vực / Tầng</th>
                                    <th>Kích thước</th>
                                    <th>Giá thuê tháng</th>
                                    <th>Trạng thái vật lý</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var unit in Model.AvailableUnits.Items)
                                {
                                    <tr class="candidate-unit-row">
                                        <td class="font-monospace fw-bold text-primary">
                                            @unit.UnitCode
                                        </td>
                                        <td>
                                            @unit.UnitTypeName
                                            @if (unit.ClimateControlled)
                                            {
                                                <span class="badge bg-info-subtle text-info border border-info-subtle ms-1" style="font-size: 0.7rem;">
                                                    Điều hòa
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @(unit.AreaName ?? "Khu chung")
                                            @if (!string.IsNullOrEmpty(unit.FloorLabel))
                                            {
                                                <span class="text-muted small">(@unit.FloorLabel)</span>
                                            }
                                        </td>
                                        <td class="small">
                                            @(unit.AreaM2.HasValue ? $"{unit.AreaM2.Value:F1} m²" : "—")
                                            <span class="text-muted">(@unit.WidthM.ToString("F1") &times; @unit.LengthM.ToString("F1") m)</span>
                                        </td>
                                        <td class="fw-semibold text-dark">
                                            @AppFormatters.FormatVnd(unit.MonthlyRate)
                                        </td>
                                        <td>
                                            <span class="badge bg-success">
                                                @unit.PhysicalStatus
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            @if (unit.HasMapPosition)
                                            {
                                                <button type="button" 
                                                        class="btn btn-outline-primary btn-sm btn-locate-on-map" 
                                                        data-unit-id="@unit.Id" 
                                                        data-unit-code="@unit.UnitCode">
                                                    Xem trên sơ đồ &rarr;
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Chưa có sơ đồ</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Phân trang ô ứng viên -->
                    @if (Model.AvailableUnits.TotalPages > 1)
                    {
                        <nav aria-label="Phân trang ô ứng viên" class="mt-3">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.AvailableUnits.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" href="@(Model.AvailableUnits.HasPreviousPage ? Model.GetCandidateUnitsPaginationUrl(Model.PageNumber - 1) : "#")">
                                        &laquo; Trước
                                    </a>
                                </li>
                                @for (int p = 1; p <= Model.AvailableUnits.TotalPages; p++)
                                {
                                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" href="@Model.GetCandidateUnitsPaginationUrl(p)">@p</a>
                                    </li>
                                }
                                <li class="page-item @(Model.AvailableUnits.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" href="@(Model.AvailableUnits.HasNextPage ? Model.GetCandidateUnitsPaginationUrl(Model.PageNumber + 1) : "#")">
                                        Sau &raquo;
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
            </div>

            <!-- ========================================== -->
            <!-- TAB 4: THÔNG TIN CHI TIẾT CƠ SỞ            -->
            <!-- ========================================== -->
            <div class="tab-pane fade @(Model.ActiveTab == "facility-info" ? "show active" : "")" 
                 id="tab-facility-info" role="tabpanel" aria-labelledby="tab-facility-info-nav">
                
                <div class="card border-0 shadow-sm bg-white">
                    <div class="card-body p-4">
                        <h2 class="h5 fw-bold text-dark mb-3">Hồ Sơ Chi Nhánh Cơ Sở Kho</h2>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <h3 class="h6 fw-semibold text-secondary mb-2">Địa chỉ &amp; Vị trí</h3>
                                    <p class="mb-1"><strong>Tên chi nhánh:</strong> @Model.Facility.Name</p>
                                    <p class="mb-1"><strong>Mã cơ sở:</strong> <span class="font-monospace">@Model.Facility.Code</span></p>
                                    <p class="mb-1"><strong>Địa chỉ:</strong> @Model.Facility.AddressLine</p>
                                    <p class="mb-1"><strong>Phường / Xã:</strong> @(Model.Facility.Ward ?? "—")</p>
                                    <p class="mb-1"><strong>Quận / Huyện:</strong> @(Model.Facility.District ?? "—")</p>
                                    <p class="mb-0"><strong>Tỉnh / Thành phố:</strong> @Model.Facility.City</p>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <h3 class="h6 fw-semibold text-secondary mb-2">Vận hành &amp; Giờ mở cửa</h3>
                                    <p class="mb-1">
                                        <strong>Giờ tiếp khách:</strong> 
                                        @AppFormatters.FormatTime(Model.Facility.OpeningTime) &mdash; @AppFormatters.FormatTime(Model.Facility.ClosingTime)
                                    </p>
                                    <p class="mb-1"><strong>Múi giờ chuẩn:</strong> <span class="font-monospace">@Model.Facility.Timezone</span></p>
                                    <p class="mb-1"><strong>Trạng thái:</strong> <span class="badge bg-success">@Model.Facility.Status</span></p>
                                    @if (Model.Facility.Latitude.HasValue && Model.Facility.Longitude.HasValue)
                                    {
                                        <p class="mb-0">
                                            <strong>Tọa độ GPS:</strong> 
                                            <span class="font-monospace">@Model.Facility.Latitude.Value.ToString("F4"), @Model.Facility.Longitude.Value.ToString("F4")</span>
                                            <a href="https://maps.google.com/?q=@Model.Facility.Latitude.Value,@Model.Facility.Longitude.Value" 
                                               target="_blank" rel="noopener noreferrer" class="ms-1">
                                                (Xem Google Maps &nearr;)
                                            </a>
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            // Khi chọn ô trên sơ đồ, ẩn placeholder và hiển thị panel
            $('#facilityFloorMapSvg').on('click', '.unit-rect', function () {
                $('#unitDetailPlaceholder').addClass('d-none');
            });
        });
    </script>
}
