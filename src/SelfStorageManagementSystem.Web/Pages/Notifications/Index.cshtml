@page "/Notifications"
@model SelfStorageManagementSystem.Web.Pages.Notifications.IndexModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Thông Báo Của Tôi";
}

<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thông báo</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Thông Báo Của Tôi</h1>
            <p class="text-muted mb-0 small">Lịch sử thông báo đặt chỗ, thanh toán, bàn giao ô kho và cập nhật hệ thống</p>
        </div>
        <div>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <span>&#8635;</span> Tải Lại
            </a>
        </div>
    </div>

    <!-- Vùng thông báo động chuẩn bị cho realtime SignalR tại T15 -->
    <div id="notificationsMessageArea" class="mb-3"></div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Danh sách thông báo -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-secondary">
                Danh Sách Thông Báo
                @if (Model.Notifications != null)
                {
                    <span class="badge bg-secondary ms-2">@Model.Notifications.TotalCount thông báo</span>
                }
            </h5>
            @if (Model.Notifications != null && Model.Notifications.TotalPages > 1)
            {
                <span class="text-muted small">Trang @Model.Notifications.CurrentPage / @Model.Notifications.TotalPages</span>
            }
        </div>

        @if (Model.Notifications == null || Model.Notifications.Items.Count == 0)
        {
            <div class="card-body text-center py-5">
                <div class="fs-1 text-muted mb-3">&#128276;</div>
                <h5 class="fw-semibold text-secondary">Hộp Thư Thông Báo Trống</h5>
                <p class="text-muted mb-0 small">
                    Bạn hiện chưa có thông báo mới nào từ hệ thống SelfStorage.
                </p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush" id="notificationsList">
                @foreach (var n in Model.Notifications.Items)
                {
                    <div class="list-group-item p-3 p-md-4 border-bottom" data-notification-id="@n.Id">
                        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fs-5 text-primary">&#128172;</span>
                                <h6 class="mb-0 fw-bold text-dark">@n.Subject</h6>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <!-- Kênh thông báo -->
                                @{
                                    var channelClass = n.Channel switch
                                    {
                                        "email" => "bg-primary-subtle text-primary border border-primary",
                                        "sms" => "bg-success-subtle text-success border border-success",
                                        "push" => "bg-warning-subtle text-warning-emphasis border border-warning",
                                        _ => "bg-secondary-subtle text-secondary border"
                                    };
                                }
                                <span class="badge @channelClass text-uppercase small">@n.Channel</span>

                                <!-- Trạng thái gửi -->
                                @if (n.Status == "sent" || n.Status == "delivered")
                                {
                                    <span class="badge bg-success small">Đã gửi</span>
                                }
                                else if (n.Status == "pending")
                                {
                                    <span class="badge bg-warning text-dark small">Đang chờ</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger small">@n.Status</span>
                                }
                            </div>
                        </div>

                        <!-- Nội dung thông báo / Payload -->
                        @if (!string.IsNullOrWhiteSpace(n.Payload))
                        {
                            <div class="p-3 bg-light rounded text-secondary small font-monospace mb-2" style="white-space: pre-wrap; word-break: break-word;">
                                @n.Payload
                            </div>
                        }

                        <div class="d-flex flex-wrap justify-content-between align-items-center text-muted small mt-2">
                            <span>
                                Mẫu thông báo: <span class="badge bg-light text-muted border font-monospace">@n.TemplateCode</span>
                            </span>
                            <span>
                                Thời điểm gửi: @AppFormatters.FormatDateTime(n.SentAt ?? n.CreatedAt)
                            </span>
                        </div>
                    </div>
                }
            </div>

            <!-- Phân trang -->
            @if (Model.Notifications.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="text-muted small">
                        Hiển thị @(((Model.Notifications.CurrentPage - 1) * Model.Notifications.PageSize) + 1) -
                        @(Math.Min(Model.Notifications.CurrentPage * Model.Notifications.PageSize, Model.Notifications.TotalCount)) trong tổng số @Model.Notifications.TotalCount thông báo
                    </span>
                    <nav aria-label="Phân trang thông báo">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Notifications.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-PageNumber="@(Model.Notifications.CurrentPage - 1)"
                                   asp-route-PageSize="@Model.Notifications.PageSize">
                                    &laquo; Trước
                                </a>
                            </li>
                            @for (var p = 1; p <= Model.Notifications.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Notifications.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-page="./Index"
                                       asp-route-PageNumber="@p"
                                       asp-route-PageSize="@Model.Notifications.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.Notifications.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-PageNumber="@(Model.Notifications.CurrentPage + 1)"
                                   asp-route-PageSize="@Model.Notifications.PageSize">
                                    Sau &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/notifications.js" asp-append-version="true"></script>
}
