@page "/Reservations/Cancel/{id:long?}"
@model SelfStorageManagementSystem.Web.Pages.Reservations.CancelModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Hủy Đơn Giữ Chỗ";
    var res = Model.Reservation;
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Reservations">Đặt chỗ của tôi</a></li>
            @if (res != null)
            {
                <li class="breadcrumb-item"><a href="/Reservations/Details?id=@res.Id">@res.ReservationCode</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">Hủy đơn</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-danger border-2">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title fw-bold mb-0">Xác Nhận Hủy Đơn Đặt Chỗ</h5>
                </div>
                <div class="card-body p-4">
                    @if (res != null)
                    {
                        <div class="alert alert-warning-subtle border border-warning-subtle small mb-4">
                            <strong>Lưu ý:</strong> Hành động này sẽ giải phóng sức chứa loại kho của bạn về cho hệ thống. Sau khi hủy, đơn đặt chỗ sẽ không thể khôi phục lại.
                        </div>

                        <div class="bg-light p-3 rounded mb-4 border">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Mã đơn:</span>
                                <strong class="font-monospace">@res.ReservationCode</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Cơ sở:</span>
                                <span class="fw-semibold">@res.FacilityName</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Loại kho:</span>
                                <span class="fw-semibold">@res.UnitTypeName</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Kỳ thuê:</span>
                                <span>@AppFormatters.FormatDate(res.StartDate) &rarr; @AppFormatters.FormatDate(res.EndDate)</span>
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top">
                                <span class="text-muted">Tổng tiền giữ chỗ:</span>
                                <strong class="text-primary font-monospace">@AppFormatters.FormatVnd(res.QuotedTotal)</strong>
                            </div>
                        </div>

                        <form method="post">
                            <input type="hidden" asp-for="Id" />

                            <div class="mb-4">
                                <label asp-for="Reason" class="form-label fw-semibold">
                                    Lý do hủy đơn (tùy chọn, tối đa 255 ký tự):
                                </label>
                                <textarea asp-for="Reason" class="form-control" rows="3" maxlength="255"
                                          placeholder="Nhập lý do hủy (ví dụ: Thay đổi thời gian chuyển đồ, đổi sang loại kho khác...)"></textarea>
                                <span asp-validation-for="Reason" class="text-danger small"></span>
                            </div>

                            <div class="d-flex gap-2 justify-content-end">
                                <a href="/Reservations/Details?id=@res.Id" class="btn btn-outline-secondary">
                                    Không hủy, quay lại
                                </a>
                                <button type="submit" class="btn btn-danger fw-semibold">
                                    Xác nhận hủy đơn &rarr;
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
