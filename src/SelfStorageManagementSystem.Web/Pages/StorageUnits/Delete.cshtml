@page
@model SelfStorageManagementSystem.Web.Pages.StorageUnits.DeleteModel
@{
    ViewData["Title"] = Model.StorageUnit != null ? $"Xóa ô kho {Model.StorageUnit.UnitCode}" : "Xác nhận xóa ô kho";
}

<div class="container py-3" style="max-width: 800px;">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-page="./Index">Quản trị ô kho</a></li>
            @if (Model.StorageUnit != null)
            {
                <li class="breadcrumb-item"><a asp-page="./Details" asp-route-id="@Model.Id">@Model.StorageUnit.UnitCode</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h1 class="h3 mb-1 fw-bold text-danger">Xác Nhận Xóa Ô Kho</h1>
        <p class="text-muted mb-0 small">
            Kiểm tra toàn diện trước khi xóa ô kho vật lý khỏi hệ thống quản lý.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>
                    <strong>Không thể xóa ô kho:</strong> @Model.ErrorMessage
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (!Model.CanManage)
    {
        <div class="alert alert-warning shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-warning fw-bold">&#9888;</span>
                <div>
                    <strong>Chế độ xem:</strong> Vai trò nhân viên cơ sở (Facility Staff) không có thẩm quyền xóa ô kho. Thao tác này yêu cầu quyền <strong>Quản lý cơ sở (Facility Manager)</strong> hoặc <strong>Quản trị viên (Administrator)</strong>.
                </div>
            </div>
        </div>
    }

    @if (!Model.CanDelete)
    {
        <div class="alert alert-danger shadow-sm mb-4 border-danger" role="alert">
            <div class="d-flex align-items-start">
                <span class="me-3 fs-4 text-danger">&#9888;</span>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Ràng buộc chính sách & tham chiếu: Không thể xóa ô kho này</h6>
                    <p class="mb-0 small">
                        @Model.BlockReason
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-warning fw-bold">&#9888;</span>
                <div>
                    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa vĩnh viễn ô kho <strong>@(Model.StorageUnit?.UnitCode)</strong> không? Thao tác này sẽ giải phóng dữ liệu và không thể hoàn tác.
                </div>
            </div>
        </div>
    }

    @if (Model.StorageUnit != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-semibold text-secondary">Chi Tiết Bản Ghi Sắp Xóa</h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-secondary small fw-bold">Mã ô kho:</dt>
                    <dd class="col-sm-8 fw-bold font-monospace text-primary fs-5">@Model.StorageUnit.UnitCode</dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Cơ sở lưu trữ:</dt>
                    <dd class="col-sm-8">
                        <div>@Model.StorageUnit.FacilityName</div>
                        <div class="small text-muted font-monospace">@Model.StorageUnit.FacilityCode (ID: @Model.StorageUnit.FacilityId)</div>
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Loại ô kho:</dt>
                    <dd class="col-sm-8">
                        <div>@Model.StorageUnit.UnitTypeName</div>
                        <div class="small text-muted font-monospace">@Model.StorageUnit.UnitTypeCode</div>
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Khu vực / Tầng / Dãy:</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrWhiteSpace(Model.StorageUnit.AreaName) ? "Chưa gán khu vực" : Model.StorageUnit.AreaName)
                        @if (!string.IsNullOrWhiteSpace(Model.StorageUnit.FloorLabel) || !string.IsNullOrWhiteSpace(Model.StorageUnit.ZoneLabel))
                        {
                            <span class="text-muted">(@Model.StorageUnit.FloorLabel - @Model.StorageUnit.ZoneLabel)</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Trạng thái vật lý:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-secondary px-2 py-1">@Model.StorageUnit.PhysicalStatus</span>
                        @if (Model.StorageUnit.IsListed)
                        {
                            <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">Niêm yết</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Cập nhật lần cuối:</dt>
                    <dd class="col-sm-8 font-monospace small text-muted">
                        @Model.StorageUnit.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")
                    </dd>
                </dl>
            </div>
        </div>

        <form method="post" id="deleteStorageUnitForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <!-- Truyền ExpectedUpdatedAt dạng round-trip để bảo vệ chống xóa đè khi dữ liệu đã stale -->
            <input type="hidden" asp-for="ExpectedUpdatedAt" value="@Model.ExpectedUpdatedAt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffffffZ")" />

            <div class="d-flex align-items-center justify-content-end gap-2">
                <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                    Hủy Bỏ
                </a>
                @if (Model.CanDelete && Model.CanManage)
                {
                    <input type="button" id="btnDeleteBySignalR" value="Delete by SignalR" class="btn btn-outline-danger px-4 fw-semibold" />
                    <button type="submit" id="btnSubmitDelete" class="btn btn-danger px-4 fw-semibold">
                        <span id="btnSubmitSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
                        <span id="btnSubmitText">Xác Nhận Xóa Ô Kho</span>
                    </button>
                }
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('deleteStorageUnitForm');
            const submitBtn = document.getElementById('btnSubmitDelete');
            const spinner = document.getElementById('btnSubmitSpinner');
            const submitText = document.getElementById('btnSubmitText');
            const canManage = @(Model.CanManage ? "true" : "false");
            const canDelete = @(Model.CanDelete ? "true" : "false");

            if (form && submitBtn) {
                form.addEventListener('submit', function (e) {
                    submitBtn.disabled = true;
                    if (spinner) spinner.classList.remove('d-none');
                    if (submitText) submitText.textContent = 'Đang xóa...';
                });
            }

            // =========================================================================
            // SignalR Delete Integration (Theo mẫu TeacherCode 2.txt & 4.txt line 1)
            // =========================================================================
            const btnDeleteBySignalR = document.getElementById("btnDeleteBySignalR");
            if (btnDeleteBySignalR && canManage && canDelete) {
                // 1. Khởi tạo HubConnection theo mẫu TeacherCode
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/storageUnitHub").configureLogging(signalR.LogLevel.None)
                    .withAutomaticReconnect()
                    .build();

                // 2. Đăng ký listeners trước connection.start()
                connection.on("Receiver_DeleteTransactionCashDepositSlip", function (id) {
                    handleRealtimeDelete(id);
                });

                connection.on("Receiver_DeleteStorageUnit", function (id) {
                    handleRealtimeDelete(id);
                });

                function handleRealtimeDelete(id) {
                    if (String(id) === "@Model.Id") {
                        btnDeleteBySignalR.disabled = true;
                        if (submitBtn) submitBtn.disabled = true;
                        window.location.href = "/StorageUnits";
                    }
                }

                connection.start().then(function () {
                }).catch(function (err) {
                    return;
                });

                // 3. Sự kiện click: gọi invoke("HubDelete_StorageUnit", id, expectedUpdatedAt)
                btnDeleteBySignalR.addEventListener("click", function (event) {
                    event.preventDefault();

                    const id = "@Model.Id";
                    const expectedUpdatedAt = document.querySelector('input[name="ExpectedUpdatedAt"]')?.value;

                    // Chống bấm đúp
                    btnDeleteBySignalR.disabled = true;
                    if (submitBtn) submitBtn.disabled = true;


                    // Hỗ trợ cả HubDelete_TransactionCashDepositSlip và HubDelete_StorageUnit
                    connection.invoke("HubDelete_StorageUnit", id, expectedUpdatedAt)
                        .then(function (result) {
                            window.location.href = "/StorageUnits";
                        })
                        .catch(function (err) {
                            btnDeleteBySignalR.disabled = false;
                            if (submitBtn) submitBtn.disabled = false;
                            alert("Lỗi khi xóa ô kho qua SignalR: " + err.toString());
                        });
                });
            }
        });
    </script>
}
