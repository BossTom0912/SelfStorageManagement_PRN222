<Window x:Class="SelfStorageManagementSystem.WpfClient.Views.MyReservationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đơn Đặt Chỗ Của Tôi - Self-Storage System" Height="650" Width="950"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DANH SÁCH ĐƠN ĐẶT CHỖ CỦA TÔI" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Theo dõi trạng thái đơn giữ chỗ (15 phút), đơn đã xác nhận và lịch sử đặt kho." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔄 Tải lại" Padding="12,6" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnRefresh_Click"/>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Lọc trạng thái:" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Grid.Column="1" x:Name="cboStatusFilter" SelectedIndex="0" SelectionChanged="CboStatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Tất cả trạng thái" Tag=""/>
                    <ComboBoxItem Content="Đang giữ chỗ (pending)" Tag="pending"/>
                    <ComboBoxItem Content="Đã xác nhận (confirmed)" Tag="confirmed"/>
                    <ComboBoxItem Content="Hết hạn (expired)" Tag="expired"/>
                    <ComboBoxItem Content="Đã hủy (cancelled)" Tag="cancelled"/>
                </ComboBox>

                <TextBlock Grid.Column="2" x:Name="lblStatusMessage" Text="" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Grid Data -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="4">
            <DataGrid x:Name="gridReservations" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Đơn" Binding="{Binding ReservationCode}" Width="160" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Cơ sở kho" Binding="{Binding FacilityName}" Width="160"/>
                    <DataGridTextColumn Header="Loại kho" Binding="{Binding UnitTypeName}" Width="130"/>
                    <DataGridTextColumn Header="Thời hạn thuê" Binding="{Binding FormattedDateRange}" Width="170"/>
                    <DataGridTextColumn Header="Tổng tiền kỳ đầu" Binding="{Binding QuotedTotal, StringFormat={}{0:N0} đ}" Width="120"/>
                    <DataGridTemplateColumn Header="Trạng thái" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusColorHex}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusDisplayName}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination & Actions -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Paging Controls -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnPrevPage" Content="◀ Trước" Padding="10,6" Margin="0,0,6,0" Click="BtnPrevPage_Click"/>
                <TextBlock x:Name="lblPageInfo" Text="Trang 1 / 1" VerticalAlignment="Center" Margin="6,0" Foreground="#64748B"/>
                <Button x:Name="btnNextPage" Content="Sau ▶" Padding="10,6" Margin="6,0,0,0" Click="BtnNextPage_Click"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Button Grid.Column="2" x:Name="btnViewDetails" Content="🔍 Xem Chi Tiết &amp; Đếm Ngược" Padding="16,8" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnViewDetails_Click"/>
            <Button Grid.Column="3" Content="Đóng" Padding="16,8" Background="#64748B" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
