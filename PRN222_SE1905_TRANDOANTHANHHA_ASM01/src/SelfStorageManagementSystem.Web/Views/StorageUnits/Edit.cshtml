@model SelfStorageManagementSystem.Web.Models.StorageUnitEditViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa ô kho {Model.Input.UnitCode}";
}

<div class="container py-3" style="max-width: 860px;">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="StorageUnits" asp-action="Index">Quản trị ô kho</a></li>
            <li class="breadcrumb-item"><a asp-controller="StorageUnits" asp-action="Details" asp-route-id="@Model.Id">@Model.Input.UnitCode</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark">Chỉnh Sửa Ô Kho: <span class="text-primary font-monospace">@Model.Input.UnitCode</span></h1>
            <p class="text-muted mb-0 small">
                Cập nhật thông tin phân khu, tầng, mã số và ghi chú vận hành cho ô kho (MVC View).
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="StorageUnits" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                Xem chi tiết
            </a>
            <a asp-controller="StorageUnits" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Danh sách
            </a>
        </div>
    </div>

    @if (!Model.CanManage)
    {
        <div class="alert alert-warning shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-warning fw-bold">&#9888;</span>
                <div>
                    <strong>Chế độ xem:</strong> Vai trò nhân viên cơ sở (Facility Staff) chỉ có quyền xem danh mục; không có thẩm quyền sửa đổi ô kho.
                </div>
            </div>
        </div>
    }

    <!-- Cảnh báo xung đột đồng thời (Concurrency Conflict / Stale Data) -->
    @if (Model.IsConcurrencyConflict)
    {
        <div class="alert alert-warning shadow-sm mb-4 border-warning" role="alert">
            <div class="d-flex align-items-start">
                <span class="me-3 fs-4 text-warning">&#9888;</span>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Phát hiện xung đột đồng thời (Dữ liệu đã thay đổi)</h6>
                    <p class="mb-2 small">
                        Bản ghi ô kho này đã được một người dùng hoặc tiến trình khác cập nhật trong khi bạn đang mở trang chỉnh sửa.
                    </p>
                    <div class="small text-muted mb-3">
                        <div>&bull; Mốc thời gian biểu mẫu của bạn: <code>@Model.Input.ExpectedUpdatedAt.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")</code></div>
                        @if (Model.LatestDbUpdatedAt.HasValue)
                        {
                            <div>&bull; Mốc thời gian mới nhất trong CSDL: <code>@Model.LatestDbUpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")</code></div>
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="StorageUnits" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm fw-semibold">
                            <span>&#8635;</span> Tải Lại Dữ Liệu Mới Nhất
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Cảnh báo realtime bản đang xem đã lỗi thời (chặn lưu đè dữ liệu) -->
    <div id="realtimeStaleWarning" class="alert alert-warning shadow-sm mb-4 border-warning d-none" role="alert">
        <div class="d-flex align-items-start">
            <span class="me-3 fs-4 text-warning">&#9888;</span>
            <div class="flex-grow-1">
                <h6 class="alert-heading fw-bold mb-1">Cảnh báo: Dữ liệu ô kho vừa được cập nhật bởi một người dùng khác</h6>
                <p class="mb-2 small">
                    Ô kho này vừa được cập nhật trên hệ thống (Cập nhật lúc: <code id="staleRemoteUpdatedAt"></code>).
                    Biểu mẫu hiện tại chứa thông tin cũ và đã bị <strong>khóa nút lưu</strong> để tránh ghi đè làm mất các thay đổi của người khác.
                </p>
                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-warning btn-sm fw-semibold" onclick="window.location.reload();">
                        <span>&#8635;</span> Tải Lại Dữ Liệu Mới Nhất
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage) && !Model.IsConcurrencyConflict)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>
                    <strong>Lỗi cập nhật:</strong> @Model.ErrorMessage
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="card-title mb-0 fw-semibold text-primary">Thông Tin Chỉnh Sửa</h5>
        </div>
        <div class="card-body p-4">
            <form asp-controller="StorageUnits" asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editStorageUnitForm">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Input.ExpectedUpdatedAt" value="@Model.Input.ExpectedUpdatedAt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffffffZ")" id="inputExpectedUpdatedAt" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm mb-4" role="alert"></div>

                <div class="row g-3">
                    <!-- Cơ sở lưu trữ (BẤT BIẾN) -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary">Cơ sở lưu trữ</label>
                        <input type="text" class="form-control bg-light" value="@Model.FacilityName (@Model.FacilityCode)" readonly disabled />
                        <div class="form-text small text-muted">Cơ sở lưu trữ là thuộc tính bất biến của ô kho vật lý.</div>
                    </div>

                    <!-- Loại ô kho (BẤT BIẾN) -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary">Loại ô kho</label>
                        <input type="text" class="form-control bg-light" value="@Model.UnitTypeName (@Model.UnitTypeCode)" readonly disabled />
                        <div class="form-text small text-muted">Loại ô kho xác định thể tích/kích thước và không thể sửa đổi sau khi tạo.</div>
                    </div>

                    <!-- Trạng thái hiện tại (BẤT BIẾN từ form này) -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary">Trạng thái vật lý</label>
                        <input type="text" class="form-control bg-light font-monospace" value="@Model.PhysicalStatus" readonly disabled />
                        <div class="form-text small text-muted">Trạng thái vật lý được luân chuyển tự động qua quy trình CheckIn / CheckOut.</div>
                    </div>

                    <!-- Trạng thái niêm yết (BẤT BIẾN từ form này) -->
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-secondary">Niêm yết danh mục</label>
                        <input type="text" class="form-control bg-light" value="@(Model.IsListed ? "Đang niêm yết (Listed)" : "Tạm ẩn (Unlisted)")" readonly disabled />
                    </div>

                    <!-- Mã ô kho (ĐƯỢC PHÉP ĐỔI) -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.UnitCode" class="form-label fw-semibold text-secondary">
                            Mã ô kho <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.UnitCode" class="form-control font-monospace" placeholder="Ví dụ: HN01-A-101" maxlength="50" required />
                        <span asp-validation-for="Input.UnitCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Khu vực trong cơ sở -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.AreaId" class="form-label fw-semibold text-secondary">
                            Khu vực (Area)
                        </label>
                        <select asp-for="Input.AreaId" class="form-select">
                            <option value="">-- Không chỉ định khu vực --</option>
                            @foreach (var a in Model.Lookups.Areas)
                            {
                                <option value="@a.Id">@a.Name (@a.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="Input.AreaId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Nhãn tầng -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.FloorLabel" class="form-label fw-semibold text-secondary">
                            Tầng (Floor Label)
                        </label>
                        <input asp-for="Input.FloorLabel" class="form-control" placeholder="Ví dụ: Tầng 1, Tầng 2..." maxlength="50" />
                        <span asp-validation-for="Input.FloorLabel" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Nhãn phân khu -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Input.ZoneLabel" class="form-label fw-semibold text-secondary">
                            Phân khu (Zone Label)
                        </label>
                        <input asp-for="Input.ZoneLabel" class="form-control" placeholder="Ví dụ: Dãy B, Khu Đông..." maxlength="50" />
                        <span asp-validation-for="Input.ZoneLabel" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Ghi chú -->
                    <div class="col-12">
                        <label asp-for="Input.Notes" class="form-label fw-semibold text-secondary">
                            Ghi chú bổ sung
                        </label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3" placeholder="Ghi chú về vị trí hoặc lịch sử..." maxlength="500"></textarea>
                        <span asp-validation-for="Input.Notes" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="StorageUnits" asp-action="Index" class="btn btn-outline-secondary px-4">
                        Hủy Bỏ
                    </a>
                    @if (Model.CanManage)
                    {
                        <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btnSubmitEdit">
                            Lưu Thay Đổi
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentUnitId = @Model.Id;
            const inputExpectedUpdatedAt = document.getElementById('inputExpectedUpdatedAt');
            const initialExpectedUpdatedAt = inputExpectedUpdatedAt ? inputExpectedUpdatedAt.value : '';

            // Kết nối SignalR để phát hiện xung đột dữ liệu đồng thời theo thời gian thực
            if (typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/storageUnitHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("Receiver_UpdateStorageUnit", function (item) {
                    if (item && item.id === currentUnitId) {
                        console.warn("Realtime: Ô kho hiện tại vừa được cập nhật bởi một client khác:", item);
                        
                        const staleWarning = document.getElementById('realtimeStaleWarning');
                        const staleTime = document.getElementById('staleRemoteUpdatedAt');
                        const btnSubmit = document.getElementById('btnSubmitEdit');

                        if (staleTime && item.updatedAt) {
                            staleTime.textContent = new Date(item.updatedAt).toLocaleString('vi-VN');
                        }
                        if (staleWarning) {
                            staleWarning.classList.remove('d-none');
                        }
                        if (btnSubmit) {
                            btnSubmit.disabled = true;
                            btnSubmit.title = "Dữ liệu đã bị thay đổi trên máy chủ. Vui lòng tải lại trang để đối chiếu.";
                        }
                    }
                });

                connection.on("Receiver_DeleteStorageUnit", function (deletedId) {
                    if (deletedId == currentUnitId) {
                        alert("Ô kho này vừa bị xóa khỏi hệ thống bởi một người dùng khác. Bạn sẽ được chuyển hướng về danh sách.");
                        window.location.href = "/StorageUnits";
                    }
                });

                connection.start().catch(err => console.error("SignalR Connection Error:", err.toString()));
            }
        });
    </script>
}
