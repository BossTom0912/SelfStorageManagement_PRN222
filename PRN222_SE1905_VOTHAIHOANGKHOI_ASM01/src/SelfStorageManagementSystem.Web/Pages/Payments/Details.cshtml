@page "/Payments/Details/{id:long?}"
@model SelfStorageManagementSystem.Web.Pages.Payments.DetailsModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = Model.Payment != null
        ? $"Chi Tiết Thanh Toán #{Model.Payment.PaymentId}"
        : "Chi Tiết Thanh Toán";
    var p = Model.Payment;
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Payments">Thanh toán</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(p != null ? $"Giao dịch #{p.PaymentId}" : "Chi tiết")</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-danger">&#9888;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <div class="mt-2">
                <a href="/Payments" class="btn btn-outline-secondary btn-sm">Quay về danh sách thanh toán</a>
            </div>
        </div>
    }
    else if (p != null)
    {
        <!-- Khu vực hiển thị thông báo Realtime SignalR (T15 R3) -->
        <div id="paymentDetailsMessageArea"></div>

        <!-- Header chính -->
        <div class="card shadow-sm border-0 mb-4 bg-white" id="paymentDetailsContainer" data-payment-id="@p.PaymentId" data-reservation-id="@p.ReservationId">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fs-4 fw-bold font-monospace text-dark">Giao dịch #@p.PaymentId</span>
                            @{
                                var badgeClass = p.Status switch
                                {
                                    "succeeded" => "badge bg-success",
                                    "pending" or "initiated" => "badge bg-warning text-dark",
                                    "failed" => "badge bg-danger",
                                    "cancelled" => "badge bg-secondary",
                                    "refunded" => "badge bg-info text-dark",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span id="paymentStatusBadge" class="@badgeClass px-3 py-1 fs-6">@p.Status</span>
                            @if (p.ReconciliationRequired)
                            {
                                <span class="badge bg-warning text-dark border border-warning px-2 py-1">Cần đối soát</span>
                            }
                        </div>
                        <div class="text-muted small">
                            Thời điểm tạo: @AppFormatters.FormatDateTime(p.CreatedAt)
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        @if (p.Status == "pending" && string.Equals(p.Provider, "demo", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="/Payments/DemoSimulator?paymentId=@p.PaymentId" class="btn btn-primary btn-sm fw-semibold">
                                ⚡ Mở Demo Simulator
                            </a>
                        }
                        @if (p.Status == "failed" && p.ReservationId.HasValue)
                        {
                            <a href="/Payments/Checkout?reservationId=@p.ReservationId" class="btn btn-outline-danger btn-sm fw-semibold">
                                &#8635; Thử lại thanh toán
                            </a>
                        }
                        <a href="/Payments" class="btn btn-outline-secondary btn-sm">
                            &larr; Danh sách thanh toán
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (p.ReconciliationRequired)
        {
            <div class="alert alert-warning shadow-sm border-warning mb-4">
                <h6 class="fw-bold mb-1">&#9888; Cần đối soát thanh toán (Reconciliation Required)</h6>
                <p class="small mb-0">
                    Khoản tiền đã được ghi nhận thành công từ nhà cung cấp nhưng đơn giữ chỗ đã hết hạn 15 phút trước thời điểm nhận được tiền. 
                    Giao dịch này cần nhân viên cơ sở hoặc quản lý đối soát và phê duyệt hoàn tiền.
                </p>
            </div>
        }

        @if (!string.IsNullOrEmpty(p.FailureReason))
        {
            <div class="alert alert-danger shadow-sm mb-4">
                <h6 class="fw-bold mb-1">&#10008; Lý do thất bại:</h6>
                <p class="small mb-0 font-monospace">@p.FailureReason</p>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Thông tin tài chính & Kỹ thuật -->
            <div class="col-lg-7">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">Thông Tin Thanh Toán</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Số tiền giao dịch:</small>
                                <span class="fs-4 fw-bold text-primary font-monospace">
                                    @AppFormatters.FormatVnd(p.Amount)
                                </span>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Loại tiền tệ:</small>
                                <strong class="text-dark">@p.Currency</strong>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Phương thức thanh toán:</small>
                                <strong class="text-dark text-uppercase">@p.Method</strong>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Nhà cung cấp cổng:</small>
                                <span class="badge bg-light text-dark border font-monospace">@p.Provider</span>
                            </div>
                            @if (!string.IsNullOrEmpty(p.ProviderTransactionId))
                            {
                                <div class="col-12">
                                    <small class="text-muted d-block">Mã tham chiếu nhà cung cấp (TxnId):</small>
                                    <span class="font-monospace text-dark bg-light px-2 py-1 rounded d-inline-block small">
                                        @p.ProviderTransactionId
                                    </span>
                                </div>
                            }
                            <div class="col-12">
                                <small class="text-muted d-block">Idempotency-Key (Khóa ổn định chống trùng lặp):</small>
                                <span class="font-monospace text-muted bg-light px-2 py-1 rounded d-inline-block small">
                                    @p.IdempotencyKey
                                </span>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Thời điểm khởi tạo:</small>
                                <span class="small text-dark">@AppFormatters.FormatDateTime(p.CreatedAt)</span>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Thời điểm hoàn tất:</small>
                                <span class="small text-dark">
                                    @(p.PaidAt.HasValue ? AppFormatters.FormatDateTime(p.PaidAt.Value) : "Chưa hoàn tất")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Hồ sơ liên quan -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">Hồ Sơ Liên Quan</h5>
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush">
                            <!-- Hóa đơn -->
                            <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">Hóa Đơn / Biên Nhận</div>
                                    <small class="text-muted font-monospace">Mã: #@p.TargetInvoiceId</small>
                                </div>
                                <a href="/Invoices/Details?id=@p.TargetInvoiceId" class="btn btn-outline-primary btn-sm">
                                    Xem hóa đơn &rarr;
                                </a>
                            </li>

                            <!-- Đơn đặt chỗ -->
                            @if (p.ReservationId.HasValue)
                            {
                                <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">Đơn Đặt Chữ Sức Chứa</div>
                                        <small class="text-muted font-monospace">Mã: @p.ReservationCode</small>
                                    </div>
                                    <a href="/Reservations/Details/@p.ReservationId" class="btn btn-outline-secondary btn-sm">
                                        Xem đơn đặt &rarr;
                                    </a>
                                </li>
                            }

                            <!-- Hợp đồng thuê kho -->
                            @if (p.AgreementId.HasValue && p.AgreementId.Value > 0)
                            {
                                <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">Hợp Đồng Thuê Kho</div>
                                        <small class="text-muted font-monospace">Mã: @(p.AgreementNo ?? $"#{p.AgreementId}")</small>
                                    </div>
                                    <a href="/Agreements/Details?id=@p.AgreementId" class="btn btn-outline-success btn-sm">
                                        Xem hợp đồng &rarr;
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/payments.js" asp-append-version="true"></script>
}
