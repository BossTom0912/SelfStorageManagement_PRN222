@page "/Payments/Checkout"
@model SelfStorageManagementSystem.Web.Pages.Payments.CheckoutModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = Model.Quote != null
        ? $"Thanh Toán Đơn Đặt Chỗ {Model.Quote.ReservationCode}"
        : "Thanh Toán Đơn Đặt Chỗ";
    var quote = Model.Quote;
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Reservations">Đặt chỗ của tôi</a></li>
            @if (quote != null)
            {
                <li class="breadcrumb-item"><a href="/Reservations/Details/@quote.ReservationId">@quote.ReservationCode</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">Thanh toán cọc & kỳ đầu</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Thanh Toán Đơn Đặt Chỗ</h1>
            <p class="text-muted mb-0">Xác nhận thanh toán tiền đặt cọc và tiền thuê kỳ đầu để kích hoạt hợp đồng thuê kho.</p>
        </div>
        @if (quote != null)
        {
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary font-monospace px-3 py-2 fs-6">@quote.ReservationCode</span>
                <a href="/Reservations/Details/@quote.ReservationId" class="btn btn-outline-secondary btn-sm">
                    &larr; Xem lại đơn đặt chỗ
                </a>
            </div>
        }
    </div>

    <!-- Thông báo lỗi hoặc thành công -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-danger">&#9888;</span>
                <div>
                    <strong>Lỗi:</strong> @Model.ErrorMessage
                </div>
            </div>
            @if (Model.IsExpired)
            {
                <div class="mt-2 small">
                    Đơn đặt chỗ đã quá thời hạn 15 phút theo quy định <strong>BR-RSV-01</strong>. Vui lòng quay lại <a href="/Catalog" class="alert-link">Danh mục kho</a> để tạo đơn đặt chỗ mới.
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-success">&#10004;</span>
                <div>@Model.SuccessMessage</div>
            </div>
        </div>
    }

    @if (quote == null && string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Đang tải báo giá...</span>
            </div>
            <p class="text-muted mt-3">Đang tải báo giá từ máy chủ...</p>
        </div>
    }
    else if (quote != null)
    {
        <!-- Bảng Đếm Ngược Giữ Chỗ (15 phút) -->
        @if (quote.IsHoldActive)
        {
            <div class="card shadow-sm border-warning border-2 mb-4 bg-warning-subtle">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-warning text-dark fw-bold">BR-RSV-01</span>
                            <span class="fw-semibold text-dark">Thời hạn giữ chỗ thanh toán:</span>
                            <span class="font-monospace fw-bold text-primary">
                                @AppFormatters.FormatDateTimeSeconds(quote.HoldUntil)
                            </span>
                        </div>
                        <div class="small text-muted">
                            Vui lòng hoàn tất thanh toán trước khi thời hạn kết thúc để giữ sức chứa loại kho.
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-4">
            <!-- Cột trái: Thông tin hợp đồng & Điều khoản -->
            <div class="col-lg-7">
                <!-- 1. Thông tin đặt chỗ -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">1. Thông Tin Kho Đặt Thuê</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Cơ sở lưu trữ:</small>
                                <strong class="text-dark fs-6">@quote.FacilityName</strong>
                            </div>
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Loại ô kho:</small>
                                <strong class="text-dark fs-6">@quote.UnitTypeName</strong>
                            </div>
                            <div class="col-sm-4">
                                <small class="text-muted d-block">Ngày bắt đầu thuê:</small>
                                <strong class="text-dark">@AppFormatters.FormatDate(quote.StartDate)</strong>
                            </div>
                            <div class="col-sm-4">
                                <small class="text-muted d-block">Ngày kết thúc thuê:</small>
                                <strong class="text-dark">@AppFormatters.FormatDate(quote.EndDate)</strong>
                            </div>
                            <div class="col-sm-4">
                                <small class="text-muted d-block">Tổng kỳ thuê:</small>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                    @quote.RentalMonths tháng
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Điều khoản hợp đồng thuê kho (Policy Terms) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title fw-bold mb-0 text-dark">2. Điều Khoản Hợp Đồng Thuê Kho</h5>
                        <span class="badge bg-secondary font-monospace">@quote.PolicyVersion</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="border rounded p-3 bg-light small mb-3" style="max-height: 180px; overflow-y: auto;">
                            <h6 class="fw-bold mb-2">Quy Định Chung Hợp Đồng Thuê Kho Tự Quản:</h6>
                            <ul class="mb-0 ps-3 text-muted">
                                <li><strong>Tiền đặt cọc (BR-FIN-01):</strong> Bằng đúng 100% tiền thuê 01 tháng, được bảo lưu và hoàn trả sau khi thanh lý hợp đồng và bàn giao kho sạch sẽ.</li>
                                <li><strong>Bàn giao tại quầy (Function 5):</strong> Hợp đồng sau khi thanh toán ở trạng thái <em>scheduled</em>. Ô kho cụ thể và mã PIN mở khóa sẽ được cấp khi khách hàng đến nhận kho tại quầy.</li>
                                <li><strong>Hàng hóa lưu trữ:</strong> Nghiêm cấm chất cháy nổ, hóa chất độc hại, hàng cấm theo quy định pháp luật.</li>
                                <li><strong>Thời hạn thanh toán:</strong> Các kỳ tiếp theo được thanh toán theo chu kỳ tháng trước ngày bắt đầu kỳ mới.</li>
                            </ul>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="chkAcceptPolicy" 
                                   name="AcceptPolicy" value="true" @(Model.AcceptPolicy ? "checked" : "") required form="checkoutForm">
                            <label class="form-check-label fw-semibold text-dark" for="chkAcceptPolicy">
                                Tôi đã đọc, hiểu rõ và đồng ý với tất cả điều khoản hợp đồng thuê kho (Phiên bản <span class="font-monospace">@quote.PolicyVersion</span>).
                            </label>
                            <span class="text-danger small d-block">
                                <span asp-validation-for="AcceptPolicy"></span>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 3. Mã giảm giá (Promotion Voucher) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">3. Mã Giảm Giá / Khuyến Mãi</h5>
                    </div>
                    <div class="card-body p-4">
                        <form method="post" asp-page-handler="ApplyPromo" class="row g-2 align-items-center">
                            <input type="hidden" name="ReservationId" value="@Model.ReservationId" />
                            <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
                            <input type="hidden" name="PaymentMethod" value="@Model.PaymentMethod" />
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-text bg-white">&#127991;</span>
                                    <input type="text" class="form-control text-uppercase" placeholder="Nhập mã ưu đãi (ví dụ: OPENING50)" 
                                           name="PromotionCode" value="@Model.PromotionCode" maxlength="50">
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-outline-primary w-100 fw-semibold">
                                    Áp dụng
                                </button>
                            </div>
                        </form>

                        @if (quote.DiscountAmount > 0)
                        {
                            <div class="alert alert-success mt-3 mb-0 py-2 small d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>Đã áp dụng:</strong> @quote.PromotionName (@quote.PromotionCode)
                                </div>
                                <span class="badge bg-success font-monospace fs-6">-@AppFormatters.FormatVnd(quote.DiscountAmount)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Cột phải: Bảng chi phí & Nút hành động -->
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 mb-4 sticky-top" style="top: 20px;">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0 text-dark">4. Chi Tiết Báo Giá Thanh Toán</h5>
                    </div>
                    <div class="card-body p-4">
                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">Tiền thuê tháng đầu:</span>
                                <span class="fw-semibold font-monospace">@AppFormatters.FormatVnd(quote.MonthlyRateSnapshot)</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <span class="text-muted">Tiền đặt cọc:</span>
                                    <div class="small text-muted">100% tiền thuê 1 tháng (BR-FIN-01)</div>
                                </div>
                                <span class="fw-semibold font-monospace">@AppFormatters.FormatVnd(quote.DepositSnapshot)</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted">Phí giữ chỗ:</span>
                                <span class="fw-semibold font-monospace">
                                    @(quote.BookingFeeSnapshot > 0 ? AppFormatters.FormatVnd(quote.BookingFeeSnapshot) : "0 ₫ (Miễn phí)")
                                </span>
                            </li>
                            @if (quote.DiscountAmount > 0)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 text-success">
                                    <div>
                                        <span>Ưu đãi giảm giá:</span>
                                        <div class="small">@quote.PromotionCode</div>
                                    </div>
                                    <span class="fw-semibold font-monospace">-@AppFormatters.FormatVnd(quote.DiscountAmount)</span>
                                </li>
                            }
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 pt-3 border-top border-2">
                                <span class="h6 fw-bold mb-0">Tổng thanh toán:</span>
                                <span class="h4 fw-bold text-primary font-monospace mb-0" id="quotedTotalDisplay">
                                    @AppFormatters.FormatVnd(quote.QuotedTotal)
                                </span>
                            </li>
                        </ul>

                        <!-- Form thanh toán chính (Checkout Form) -->
                        <form method="post" id="checkoutForm">
                            <input type="hidden" name="ReservationId" value="@Model.ReservationId" />
                            <input type="hidden" name="PromotionCode" value="@Model.PromotionCode" />
                            <input type="hidden" name="AcceptedPolicyVersionId" value="@quote.PolicyVersionId" />
                            <input type="hidden" name="IdempotencyKey" id="idempotencyKeyInput" value="@Model.IdempotencyKey" />

                            <!-- Chọn cổng thanh toán -->
                            <div class="mb-4">
                                <label class="form-label fw-bold text-dark small">Phương Thức Thanh Toán:</label>
                                <div class="form-check p-3 border rounded mb-2 bg-light">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="methodDemo" 
                                           value="demo" @(Model.PaymentMethod == "demo" ? "checked" : "")>
                                    <label class="form-check-label d-block" for="methodDemo">
                                        <div class="fw-bold text-dark">🏦 Cổng Thử Nghiệm (Demo Simulator)</div>
                                        <div class="text-muted small">Thao tác mô phỏng trực tiếp trên giao diện Web với Cookie & Antiforgery (Dev/Test).</div>
                                    </label>
                                </div>
                                <div class="form-check p-3 border rounded">
                                    <input class="form-check-input" type="radio" name="PaymentMethod" id="methodVnpay" 
                                           value="vnpay" @(Model.PaymentMethod == "vnpay" ? "checked" : "")>
                                    <label class="form-check-label d-block" for="methodVnpay">
                                        <div class="fw-bold text-dark">💳 Cổng Thanh Toán VNPAY</div>
                                        <div class="text-muted small">Thanh toán qua mã QR, thẻ ATM nội địa, hoặc thẻ tín dụng quốc tế (Sandbox).</div>
                                    </label>
                                </div>
                            </div>

                            <div class="alert alert-light border small text-muted mb-4">
                                <strong>📌 Idempotency-Key:</strong> <span class="font-monospace">@Model.IdempotencyKey</span><br>
                                Khóa định danh giao dịch duy nhất chống trùng lặp, bảo đảm tính toàn vẹn khi thử lại hoặc gặp sự cố mạng.
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success fw-bold py-3 shadow-sm fs-5" id="btnSubmitCheckout"
                                        @(Model.IsExpired ? "disabled" : "")>
                                    &#128179; Xác Nhận & Thanh Toán Ngay
                                </button>
                                <a href="/Reservations/Details/@quote.ReservationId" class="btn btn-outline-secondary btn-sm">
                                    Hủy thao tác, quay lại đơn đặt chỗ
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('checkoutForm');
            var submitBtn = document.getElementById('btnSubmitCheckout');
            var chkAccept = document.getElementById('chkAcceptPolicy');

            if (form && submitBtn) {
                form.addEventListener('submit', function (e) {
                    if (chkAccept && !chkAccept.checked) {
                        return; // Để client-side validation hiển thị thông báo
                    }

                    if (submitBtn.disabled) {
                        e.preventDefault();
                        return false;
                    }

                    // Chống double submit: khóa nút và hiển thị trạng thái đang xử lý
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang khởi tạo thanh toán...';
                });
            }
        });
    </script>
}
