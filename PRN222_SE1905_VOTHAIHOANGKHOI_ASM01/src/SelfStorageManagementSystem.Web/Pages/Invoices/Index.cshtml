@page "/Invoices"
@model SelfStorageManagementSystem.Web.Pages.Invoices.IndexModel
@{
    ViewData["Title"] = "Hóa Đơn & Biên Nhận";
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hóa đơn</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Hóa Đơn & Biên Nhận Thanh Toán</h1>
            <p class="text-muted mb-0">Tra cứu thông tin chi tiết các hóa đơn tiền thuê kho và tiền cọc bảo lưu.</p>
        </div>
        <div>
            <a href="/Payments" class="btn btn-outline-primary fw-semibold">
                Lịch sử thanh toán &rarr;
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Form tra cứu hóa đơn theo mã -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-dark">🔍 Tra Cứu Hóa Đơn Theo Mã</h5>
                </div>
                <div class="card-body p-4">
                    <form method="get" action="/Invoices/Details" class="d-flex gap-2 mb-3">
                        <input type="number" class="form-control font-monospace" name="id" placeholder="Nhập mã hóa đơn (ví dụ: 1)" required min="1">
                        <button type="submit" class="btn btn-primary fw-semibold text-nowrap">
                            Xem hóa đơn &rarr;
                        </button>
                    </form>
                    <div class="small text-muted">
                        Mã số hóa đơn được hiển thị trong kết quả thanh toán hoặc chi tiết giao dịch.
                    </div>
                </div>
            </div>
        </div>

        <!-- Hướng dẫn và quy chuẩn tài chính -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-header bg-light py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-dark">📌 Quy Định Về Hóa Đơn & Tài Chính</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="mb-0 small text-muted ps-3">
                        <li class="mb-2"><strong>BR-FIN-01:</strong> Tiền đặt cọc luôn bằng đúng 100% tiền thuê 01 tháng theo biểu giá niêm yết tại thời điểm đặt kho.</li>
                        <li class="mb-2"><strong>Khởi tạo hóa đơn:</strong> Hóa đơn được tự động lập khi khách hàng thực hiện checkout tại trang <a href="/Reservations">Đặt chỗ</a>.</li>
                        <li><strong>Xác nhận thanh toán:</strong> Hóa đơn chuyển trạng thái <code>paid</code> ngay khi máy chủ nhận được IPN hợp lệ từ VNPAY hoặc hoàn tất Demo Simulator.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
