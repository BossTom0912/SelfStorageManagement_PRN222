@page "/Catalog"
@model SelfStorageManagementSystem.Web.Pages.Catalog.IndexModel
@using SelfStorageManagementSystem.Web.Models
@{
    ViewData["Title"] = "Danh Mục Cơ Sở Lưu Trữ";
}

<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Danh mục cơ sở kho</li>
        </ol>
    </nav>

    <!-- Tiêu đề trang và phần giới thiệu -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Hệ Thống Cơ Sở Kho Tự Quản</h1>
            <p class="text-secondary mb-0">Khám phá các chi nhánh, tra cứu giá niêm yết, sức chứa và sơ đồ mặt bằng thực tế.</p>
        </div>
        <div class="mt-2 mt-md-0">
            <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm">
                @Model.Facilities.TotalCount Cơ sở đang hoạt động
            </span>
        </div>
    </div>

    <!-- Thông báo lỗi nếu có -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">&#9888;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Khối bộ lọc tìm kiếm cơ sở (Filter Card) -->
    <div class="card catalog-filter-card mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" action="/Catalog" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label for="filterSearchTerm" class="form-label fw-semibold text-secondary small mb-1">Từ khóa tìm kiếm</label>
                    <input type="text" class="form-control" id="filterSearchTerm" name="SearchTerm" 
                           value="@Model.SearchTerm" placeholder="Tên cơ sở, mã chi nhánh, địa chỉ..." />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label for="filterCity" class="form-label fw-semibold text-secondary small mb-1">Tỉnh / Thành phố</label>
                    <input type="text" class="form-control" id="filterCity" name="City" 
                           value="@Model.City" placeholder="Ví dụ: Hồ Chí Minh, Hà Nội..." />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label for="filterDistrict" class="form-label fw-semibold text-secondary small mb-1">Quận / Huyện</label>
                    <input type="text" class="form-control" id="filterDistrict" name="District" 
                           value="@Model.District" placeholder="Ví dụ: Tân Bình, Cầu Giấy..." />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold d-flex align-items-center justify-content-center">
                        <span class="me-1">&#128269;</span> Tìm kiếm
                    </button>
                    <a href="/Catalog" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">&#8635;</a>
                </div>
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
            </form>
        </div>
    </div>

    <!-- Kết quả tìm kiếm -->
    @if (Model.Facilities.Items.Count == 0)
    {
        <!-- Giao diện rỗng khi không tìm thấy cơ sở phù hợp -->
        <partial name="_EmptyState" model='new EmptyStateViewModel
        {
            Title = "Không tìm thấy cơ sở kho nào phù hợp",
            Message = "Không có cơ sở nào khớp với tiêu chí tìm kiếm hiện tại. Quý khách vui lòng thử thay đổi từ khóa hoặc xóa bộ lọc.",
            ActionText = "Xóa toàn bộ bộ lọc",
            ActionUrl = "/Catalog"
        }' />
    }
    else
    {
        <!-- Lưới thẻ các cơ sở kho -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            @foreach (var fac in Model.Facilities.Items)
            {
                <div class="col">
                    <div class="facility-card shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary text-white font-monospace">@fac.Code</span>
                            @if (fac.Status == "active")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    &#9679; Đang hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                    @fac.Status
                                </span>
                            }
                        </div>
                        <div class="card-body">
                            <h2 class="h5 fw-bold text-dark mb-2">@fac.Name</h2>
                            <p class="text-secondary small mb-3">
                                <span class="me-1">&#128205;</span>
                                @fac.AddressLine@(string.IsNullOrWhiteSpace(fac.Ward) ? "" : $", {fac.Ward}"), @fac.District, @fac.City
                            </p>
                            <div class="p-2 rounded bg-light border border-light-subtle small mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Giờ mở cửa:</span>
                                    <span class="fw-semibold text-dark">
                                        @AppFormatters.FormatTime(fac.OpeningTime) &mdash; @AppFormatters.FormatTime(fac.ClosingTime)
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Múi giờ vận hành:</span>
                                    <span class="text-dark font-monospace small">@fac.Timezone</span>
                                </div>
                            </div>

                            @if (fac.Latitude.HasValue && fac.Longitude.HasValue)
                            {
                                <div class="small text-muted mb-2">
                                    <span class="me-1">&#127758;</span>Tọa độ:
                                    <span class="font-monospace">@fac.Latitude.Value.ToString("F4"), @fac.Longitude.Value.ToString("F4")</span>
                                    <a href="https://maps.google.com/?q=@fac.Latitude.Value,@fac.Longitude.Value" 
                                       target="_blank" rel="noopener noreferrer" class="ms-1 text-decoration-none">
                                        (Bản đồ số &nearr;)
                                    </a>
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="/Catalog/Details?facilityId=@fac.Id" class="btn btn-primary w-100 fw-semibold">
                                Xem chi tiết & sơ đồ kho &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Điều hướng phân trang (Pagination) -->
        @if (Model.Facilities.TotalPages > 1)
        {
            <nav aria-label="Điều hướng trang danh mục cơ sở" class="mt-4">
                <ul class="pagination justify-content-center">
                    <!-- Trang trước -->
                    <li class="page-item @(Model.Facilities.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" href="@(Model.Facilities.HasPreviousPage ? Model.GetPaginationUrl(Model.PageNumber - 1) : "#")" aria-label="Trang trước">
                            &laquo; Trang trước
                        </a>
                    </li>

                    <!-- Các trang số -->
                    @for (int p = 1; p <= Model.Facilities.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="@Model.GetPaginationUrl(p)">@p</a>
                        </li>
                    }

                    <!-- Trang sau -->
                    <li class="page-item @(Model.Facilities.HasNextPage ? "" : "disabled")">
                        <a class="page-link" href="@(Model.Facilities.HasNextPage ? Model.GetPaginationUrl(Model.PageNumber + 1) : "#")" aria-label="Trang sau">
                            Trang sau &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
