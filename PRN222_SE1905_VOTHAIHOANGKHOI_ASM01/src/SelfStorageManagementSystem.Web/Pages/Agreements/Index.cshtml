@page "/Agreements"
@model SelfStorageManagementSystem.Web.Pages.Agreements.IndexModel
@using SelfStorageManagementSystem.BusinessLogic.Common.Constants
@{
    ViewData["Title"] = "Hợp Đồng Thuê Kho";
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hợp đồng thuê</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Hợp Đồng Thuê Kho Tự Quản</h1>
            <p class="text-muted mb-0">Quản lý các hợp đồng thuê kho, thời hạn hợp đồng và tiến trình bàn giao nhận ô kho.</p>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole(RoleConstants.FacilityStaff) || User.IsInRole(RoleConstants.FacilityManager))
            {
                <a href="/Staff/CheckIn" class="btn btn-outline-primary fw-semibold">
                    Quầy tiếp nhận check-in &rarr;
                </a>
            }
            <a href="/Reservations" class="btn btn-outline-secondary fw-semibold">
                Đơn đặt chỗ &rarr;
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Form tra cứu hợp đồng theo mã -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-dark">🔍 Tra Cứu Hợp Đồng Theo Mã</h5>
                </div>
                <div class="card-body p-4">
                    <form method="get" action="/Agreements/Details" class="d-flex gap-2 mb-3">
                        <input type="number" class="form-control font-monospace" name="id" placeholder="Nhập mã hợp đồng (ví dụ: 1)" required min="1">
                        <button type="submit" class="btn btn-primary fw-semibold text-nowrap">
                            Xem hợp đồng &rarr;
                        </button>
                    </form>
                    <div class="small text-muted">
                        Mã số hợp đồng được hiển thị trong kết quả thanh toán thành công hoặc biên nhận hóa đơn.
                    </div>
                </div>
            </div>
        </div>

        <!-- Quy trình vòng đời hợp đồng -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100 bg-light">
                <div class="card-header bg-light py-3 border-bottom">
                    <h5 class="card-title fw-bold mb-0 text-dark">📌 Vòng Đời Hợp Đồng Thuê Kho</h5>
                </div>
                <div class="card-body p-4">
                    <ul class="mb-0 small text-muted ps-3">
                        <li class="mb-2"><strong>1. Trạng thái Scheduled:</strong> Được tự động khởi tạo ngay khi khách hàng hoàn tất thanh toán tiền cọc (BR-FIN-01) và tiền thuê kỳ đầu. Ô kho chưa được gán cố định.</li>
                        <li class="mb-2"><strong>2. Bàn giao tại quầy (Function 5):</strong> Nhân viên tiếp nhận khách hàng, kiểm tra CCCD, gán ô kho thực tế và hoàn tất thủ tục bàn giao.</li>
                        <li><strong>3. Trạng thái Active:</strong> Hợp đồng chính thức kích hoạt sau khi check-in, khách hàng nhận mã PIN mở khóa và bắt đầu sử dụng kho.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
