@page "/MyUnits"
@model SelfStorageManagementSystem.Web.Pages.MyUnits.IndexModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Ô Kho Của Tôi";
}

<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ô kho của tôi</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Ô Kho Của Tôi</h1>
            <p class="text-muted mb-0 small">Danh sách các ô kho vật lý bạn đang thuê và thông tin biên bản bàn giao</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Catalog" class="btn btn-outline-primary shadow-sm">
                <span>&#128269;</span> Thuê Thêm Kho
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <span>&#8635;</span> Tải Lại
            </a>
        </div>
    </div>

    <!-- Vùng thông báo động chuẩn bị cho realtime SignalR tại T15 -->
    <div id="myUnitsMessageArea" class="mb-3"></div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Danh sách ô kho -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-secondary">
                Danh Sách Ô Kho Đã Thuê
                @if (Model.Units != null)
                {
                    <span class="badge bg-secondary ms-2">@Model.Units.TotalCount ô kho</span>
                }
            </h5>
            @if (Model.Units != null && Model.Units.TotalPages > 1)
            {
                <span class="text-muted small">Trang @Model.Units.CurrentPage / @Model.Units.TotalPages</span>
            }
        </div>

        @if (Model.Units == null || Model.Units.Items.Count == 0)
        {
            <div class="card-body text-center py-5">
                <div class="fs-1 text-muted mb-3">&#128230;</div>
                <h5 class="fw-semibold text-secondary">Bạn Chưa Có Ô Kho Nào Được Bàn Giao</h5>
                <p class="text-muted mb-4 small">
                    Bạn hiện chưa có hợp đồng thuê kho nào đã hoàn tất bàn giao. Hãy khám phá danh mục để chọn ô kho phù hợp!
                </p>
                <a href="/Catalog" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    Khám Phá Danh Mục Kho
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="myUnitsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Mã ô kho</th>
                            <th>Cơ sở lưu trữ</th>
                            <th>Loại kho / Diện tích</th>
                            <th>Mã hợp đồng</th>
                            <th>Kỳ hạn thuê</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-3" style="width: 170px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var unit in Model.Units.Items)
                        {
                            <tr data-unit-agreement-id="@unit.AgreementId">
                                <td class="ps-3">
                                    <span class="fw-bold fs-6 text-primary">@(unit.UnitCode ?? "Chưa gán ô")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold">@unit.FacilityName</div>
                                </td>
                                <td>
                                    <div>@unit.UnitTypeName</div>
                                    <span class="badge bg-light text-dark border small">@unit.AreaM2.ToString("F1") m²</span>
                                </td>
                                <td>
                                    <span class="font-monospace fw-semibold text-secondary">@unit.AgreementNo</span>
                                </td>
                                <td class="small">
                                    <div>Từ: @AppFormatters.FormatDate(unit.StartDate)</div>
                                    <div>Đến: @AppFormatters.FormatDate(unit.EndDate)</div>
                                </td>
                                <td>
                                    @if (unit.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Đang sử dụng</span>
                                    }
                                    else if (unit.AgreementStatus == "completed")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Đã kết thúc</span>
                                    }
                                    else if (unit.AgreementStatus == "terminated")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Đã chấm dứt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info px-2 py-1">@unit.AgreementStatus</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-page="./HandoverDetails" asp-route-agreementId="@unit.AgreementId"
                                       class="btn btn-sm btn-outline-primary" id="btnHandoverDetails_@unit.AgreementId">
                                        Biên Bản Bàn Giao &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            @if (Model.Units.TotalPages > 1)
            {
                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="text-muted small">
                        Hiển thị @(((Model.Units.CurrentPage - 1) * Model.Units.PageSize) + 1) -
                        @(Math.Min(Model.Units.CurrentPage * Model.Units.PageSize, Model.Units.TotalCount)) trong tổng số @Model.Units.TotalCount ô kho
                    </span>
                    <nav aria-label="Phân trang ô kho">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Units.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-PageNumber="@(Model.Units.CurrentPage - 1)"
                                   asp-route-PageSize="@Model.Units.PageSize">
                                    &laquo; Trước
                                </a>
                            </li>
                            @for (var p = 1; p <= Model.Units.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Units.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-page="./Index"
                                       asp-route-PageNumber="@p"
                                       asp-route-PageSize="@Model.Units.PageSize">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.Units.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-PageNumber="@(Model.Units.CurrentPage + 1)"
                                   asp-route-PageSize="@Model.Units.PageSize">
                                    Sau &raquo;
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/my-units.js" asp-append-version="true"></script>
}
