@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-5">
                <div class="text-danger display-1 fw-bold mb-3">&#128683; 403</div>
                <h3 class="fw-bold text-danger mb-3">Từ Chối Quyền Truy Cập (Forbidden)</h3>
                <h5 class="text-secondary mb-4">Bạn không có quyền thực hiện chức năng hoặc truy cập tài nguyên này!</h5>
                <p class="text-muted mb-4 small">
                    Nếu bạn tin rằng đây là sự nhầm lẫn, vui lòng liên hệ quản trị viên hệ thống hoặc đăng nhập bằng tài khoản có phân quyền phù hợp.
                </p>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">
                        &larr; Trang chủ
                    </a>
                    <a href="/Account/Login" class="btn btn-primary px-4">
                        Đăng nhập tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
