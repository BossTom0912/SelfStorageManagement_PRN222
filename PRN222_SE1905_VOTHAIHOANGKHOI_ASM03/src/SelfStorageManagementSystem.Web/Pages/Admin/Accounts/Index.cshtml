@page "/Admin/Accounts"
@model SelfStorageManagementSystem.Web.Pages.Admin.Accounts.IndexModel
@using SelfStorageManagementSystem.BusinessLogic.Common.Constants
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Quản Trị Tài Khoản & Phân Quyền";
}

<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề trang -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản trị tài khoản</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Quản Trị Tài Khoản &amp; Phân Quyền</h1>
            <p class="text-muted mb-0 small">Quản lý người dùng, hồ sơ nhân sự, phân bổ cơ sở và phân quyền hệ thống</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Create" class="btn btn-primary shadow-sm" id="btnCreateStaffAccount">
                <span class="me-1 fw-bold">&#43;</span> Thêm Nhân Viên Mới
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <span>&#8635;</span> Tải Lại
            </a>
        </div>
    </div>

    <!-- Vùng thông báo động chuẩn bị cho realtime SignalR tại T15 -->
    <div id="adminAccountsMessageArea" class="mb-3"></div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-success fw-bold">&#10004;</span>
                <div>@Model.SuccessMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Thẻ bộ lọc tìm kiếm -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small text-muted">Từ khóa tìm kiếm</label>
                    <input type="text" name="SearchTerm" class="form-control" placeholder="Email, họ tên, mã NV, SĐT..."
                           value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Trạng thái tài khoản</label>
                    <select name="Status" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="active" selected="@(Model.Status == "active")">Hoạt động (active)</option>
                        <option value="locked" selected="@(Model.Status == "locked")">Đã khóa (locked)</option>
                        <option value="disabled" selected="@(Model.Status == "disabled")">Vô hiệu hóa (disabled)</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small text-muted">Vai trò hệ thống</label>
                    <select name="RoleCode" class="form-select">
                        <option value="">-- Tất cả vai trò --</option>
                        <option value="system_administrator" selected="@(Model.RoleCode == "system_administrator")">Quản trị viên (system_administrator)</option>
                        <option value="business_operations_manager" selected="@(Model.RoleCode == "business_operations_manager")">Quản lý vận hành (operations)</option>
                        <option value="facility_manager" selected="@(Model.RoleCode == "facility_manager")">Quản lý cơ sở (facility_manager)</option>
                        <option value="facility_staff" selected="@(Model.RoleCode == "facility_staff")">Nhân viên quầy (facility_staff)</option>
                        <option value="storage_customer" selected="@(Model.RoleCode == "storage_customer")">Khách hàng thuê kho (storage_customer)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <span>&#128269;</span> Lọc
                    </button>
                    <a asp-page="./Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                        &#10005;
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách tài khoản -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-secondary">
                Danh Sách Tài Khoản
                @if (Model.Accounts != null)
                {
                    <span class="badge bg-secondary ms-2">@Model.Accounts.TotalCount bản ghi</span>
                }
            </h5>
            @if (Model.Accounts != null && Model.Accounts.TotalPages > 1)
            {
                <span class="text-muted small">Trang @Model.Accounts.CurrentPage / @Model.Accounts.TotalPages</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="accountsTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 70px;">ID</th>
                        <th>Thông tin tài khoản</th>
                        <th>Họ tên / Mã NV</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end pe-3" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Accounts == null || Model.Accounts.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="mb-2 fs-3">&#128100;</div>
                                <div class="fw-semibold">Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm.</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var acc in Model.Accounts.Items)
                        {
                            <tr data-account-id="@acc.Id">
                                <td class="ps-3 fw-bold text-muted">#@acc.Id</td>
                                <td>
                                    <div class="fw-semibold text-dark">@acc.Email</div>
                                    @if (!string.IsNullOrWhiteSpace(acc.PhoneNumber))
                                    {
                                        <div class="text-muted small">&#9742; @acc.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium">@(acc.FullName ?? "—")</div>
                                    @if (!string.IsNullOrWhiteSpace(acc.EmployeeCode))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace small">Mã: @acc.EmployeeCode</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var role in acc.Roles)
                                        {
                                            var badgeClass = role switch
                                            {
                                                "system_administrator" => "bg-danger text-white",
                                                "business_operations_manager" => "bg-warning text-dark",
                                                "facility_manager" => "bg-info text-dark",
                                                "facility_staff" => "bg-primary text-white",
                                                _ => "bg-secondary text-white"
                                            };
                                            <span class="badge @badgeClass" style="font-size: 0.75rem;">@role</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (acc.Status == "active")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Hoạt động</span>
                                    }
                                    else if (acc.Status == "locked")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Vô hiệu hóa</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @AppFormatters.FormatDateTime(acc.CreatedAt)
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-page="./Details" asp-route-id="@acc.Id" class="btn btn-sm btn-outline-primary" id="btnDetails_@acc.Id">
                                        Chi tiết &amp; Quyền &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.Accounts != null && Model.Accounts.TotalPages > 1)
        {
            <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="text-muted small">
                    Hiển thị @(((Model.Accounts.CurrentPage - 1) * Model.Accounts.PageSize) + 1) -
                    @(Math.Min(Model.Accounts.CurrentPage * Model.Accounts.PageSize, Model.Accounts.TotalCount)) trong tổng số @Model.Accounts.TotalCount tài khoản
                </span>
                <nav aria-label="Phân trang tài khoản">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Accounts.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-page="./Index"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-Status="@Model.Status"
                               asp-route-RoleCode="@Model.RoleCode"
                               asp-route-PageNumber="@(Model.Accounts.CurrentPage - 1)"
                               asp-route-PageSize="@Model.Accounts.PageSize">
                                &laquo; Trước
                            </a>
                        </li>
                        @for (var p = 1; p <= Model.Accounts.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Accounts.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="./Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-Status="@Model.Status"
                                   asp-route-RoleCode="@Model.RoleCode"
                                   asp-route-PageNumber="@p"
                                   asp-route-PageSize="@Model.Accounts.PageSize">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.Accounts.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-page="./Index"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-Status="@Model.Status"
                               asp-route-RoleCode="@Model.RoleCode"
                               asp-route-PageNumber="@(Model.Accounts.CurrentPage + 1)"
                               asp-route-PageSize="@Model.Accounts.PageSize">
                                Sau &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-accounts.js" asp-append-version="true"></script>
}
