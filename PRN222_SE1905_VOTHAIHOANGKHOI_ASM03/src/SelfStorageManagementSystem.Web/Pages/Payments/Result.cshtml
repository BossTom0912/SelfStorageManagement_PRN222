@page "/Payments/Result"
@model SelfStorageManagementSystem.Web.Pages.Payments.ResultModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = "Kết Quả Thanh Toán";
    var p = Model.Payment;
}

<div class="container py-4">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Payments">Thanh toán</a></li>
            <li class="breadcrumb-item active" aria-current="page">Kết quả giao dịch</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-danger">&#9888;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <div class="mt-3">
                <a href="/Reservations" class="btn btn-outline-secondary btn-sm">Quay lại danh sách đặt chỗ</a>
            </div>
        </div>
    }
    else if (p != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7">
                @if (p.Status == "succeeded")
                {
                    <div class="card shadow border-0 overflow-hidden text-center mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-success text-white py-4">
                            <div class="display-4 mb-2">&#10004;</div>
                            <h3 class="fw-bold mb-1">Thanh Toán Thành Công!</h3>
                            <div class="small opacity-75">Giao dịch thanh toán cọc và kỳ thuê đầu tiên đã được xác nhận.</div>
                        </div>

                        <div class="card-body p-4 text-start">
                            @if (p.ReconciliationRequired)
                            {
                                <div class="alert alert-warning border shadow-sm mb-4">
                                    <h6 class="fw-bold text-dark mb-1">&#9888; Cần Đối Soát (Late Payment Hold Expired):</h6>
                                    <p class="small mb-0 text-dark">
                                        Khoản tiền đã đến hệ thống nhưng đơn giữ chỗ đã hết hạn 15 phút trước khi hoàn tất. 
                                        Giao dịch này được đưa vào diện <strong>Cần đối soát (Reconciliation Required)</strong> 
                                        để nhân viên hoặc quản lý cơ sở tiến hành phê duyệt hoàn tiền (Refund) hoặc hỗ trợ gia hạn cho bạn.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success border-success-subtle bg-success-subtle text-dark small mb-4">
                                    <strong>🎉 Hợp đồng thuê kho đã được khởi tạo thành công:</strong><br>
                                    Hợp đồng hiện ở trạng thái <strong>Chờ bàn giao (scheduled)</strong>. 
                                    Bạn có thể mang CCCD/CMND đến quầy lễ tân của cơ sở để làm thủ tục check-in nhận ô kho và mã PIN mở khóa.
                                </div>
                            }

                            <!-- Bảng tóm tắt thông tin thanh toán -->
                            <div class="bg-light p-3 rounded mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Mã giao dịch (Payment ID):</span>
                                    <span class="font-monospace fw-bold text-dark">#@p.PaymentId</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Đơn đặt chỗ tương ứng:</span>
                                    <span class="badge bg-secondary font-monospace">@p.ReservationCode</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Phương thức / Cổng:</span>
                                    <span class="fw-semibold text-dark text-uppercase">@p.Method (@p.Provider)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(p.ProviderTransactionId))
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted small">Mã tham chiếu ngân hàng:</span>
                                        <span class="font-monospace small text-dark">@p.ProviderTransactionId</span>
                                    </div>
                                }
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Thời điểm thanh toán:</span>
                                    <span class="small text-dark">@AppFormatters.FormatDateTime(p.PaidAt)</span>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark">Số tiền đã thanh toán:</span>
                                    <span class="fs-4 fw-bold text-success font-monospace">
                                        @AppFormatters.FormatVnd(p.Amount)
                                    </span>
                                </div>
                            </div>

                            <!-- Các nút liên kết hành động -->
                            <div class="d-grid gap-2">
                                @if (p.AgreementId.HasValue && p.AgreementId.Value > 0)
                                {
                                    <a href="/Agreements/Details?id=@p.AgreementId" class="btn btn-primary fw-bold py-2">
                                        📄 Xem Hợp Đồng Thuê Kho (@p.AgreementNo) &rarr;
                                    </a>
                                }
                                <a href="/Invoices/Details?id=@p.TargetInvoiceId" class="btn btn-outline-primary fw-semibold">
                                    🧾 Xem Hóa Đơn / Biên Nhận
                                </a>
                                <a href="/Payments/Details?id=@p.PaymentId" class="btn btn-outline-secondary btn-sm">
                                    🔍 Xem chi tiết bản ghi thanh toán
                                </a>
                                <a href="/Reservations" class="btn btn-link text-decoration-none btn-sm">
                                    Quay về danh sách đặt chỗ của tôi
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else if (p.Status == "failed" || p.Status == "cancelled")
                {
                    <div class="card shadow border-0 overflow-hidden text-center mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-danger text-white py-4">
                            <div class="display-4 mb-2">&#10008;</div>
                            <h3 class="fw-bold mb-1">Giao Dịch Không Thành Công</h3>
                            <div class="small opacity-75">Thanh toán không thể hoàn tất hoặc đã bị hủy.</div>
                        </div>

                        <div class="card-body p-4 text-start">
                            <div class="alert alert-danger border small mb-4">
                                <strong>Lý do:</strong> @(p.FailureReason ?? "Giao dịch thanh toán bị từ chối hoặc đã hết hạn.")
                            </div>

                            <p class="text-muted small mb-4">
                                Giao dịch thanh toán trước đó đã kết thúc với trạng thái <code>@p.Status</code>. 
                                Theo quy tắc bảo đảm an toàn dữ liệu, bạn có thể tạo phiên thanh toán mới (hệ thống sẽ cấp Idempotency-Key mới) 
                                nếu thời gian giữ chỗ của đơn vẫn còn hiệu lực.
                            </p>

                            <div class="d-grid gap-2">
                                <a href="/Payments/Checkout?reservationId=@p.ReservationId" class="btn btn-danger fw-bold py-2">
                                    &#8635; Thử Lại Thanh Toán (Phiên Mới)
                                </a>
                                <a href="/Reservations/Details/@p.ReservationId" class="btn btn-outline-secondary btn-sm">
                                    Quay lại chi tiết đơn đặt chỗ
                                </a>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow border-0 overflow-hidden text-center mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-warning text-dark py-4">
                            <div class="display-4 mb-2">&#9203;</div>
                            <h3 class="fw-bold mb-1">Giao Dịch Đang Chờ Xử Lý</h3>
                            <div class="small">Trạng thái: <span class="badge bg-dark">@p.Status</span></div>
                        </div>

                        <div class="card-body p-4 text-start">
                            <p class="small text-muted mb-4">
                                Giao dịch đang chờ phản hồi từ nhà cung cấp thanh toán hoặc đang được giữ chỗ. 
                                Nếu bạn đang sử dụng phương thức thử nghiệm Demo, vui lòng chuyển tới cổng giả lập để hoàn tất.
                            </p>

                            <div class="d-grid gap-2">
                                @if (string.Equals(p.Provider, "demo", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="/Payments/DemoSimulator?paymentId=@p.PaymentId" class="btn btn-primary fw-bold py-2">
                                        ⚡ Mở Cổng Demo Simulator
                                    </a>
                                }
                                <a href="/Payments/Details?id=@p.PaymentId" class="btn btn-outline-secondary btn-sm">
                                    Xem chi tiết giao dịch
                                </a>
                                <a href="/Reservations" class="btn btn-link text-decoration-none btn-sm">
                                    Quay về danh sách đặt chỗ
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
