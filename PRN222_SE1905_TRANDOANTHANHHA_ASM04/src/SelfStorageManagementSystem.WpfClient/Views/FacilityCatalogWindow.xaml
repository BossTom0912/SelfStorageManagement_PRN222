<Window x:Class="SelfStorageManagementSystem.WpfClient.Views.FacilityCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Self-Storage System - Tra cứu Cơ sở, Bảng giá &amp; Ô kho Khả dụng"
        Height="800" Width="1200" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="HỆ THỐNG TRA CỨU CƠ SỞ &amp; BẢNG GIÁ KHO LƯU TRỮ"
                               Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Tra cứu chi nhánh, loại kho, giá niêm yết và trạng thái ô kho thực tế theo quy tắc BR-OPS-02 &amp; BR-RSV-03"
                               Foreground="#94A3B8" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="lblUserSession" Text="Khách vãng lai (Public)" Foreground="#CBD5E1"
                               VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" FontWeight="SemiBold"/>
                    <Button x:Name="btnMyReservations" Content="📋 Đơn đặt chỗ của tôi" Padding="12,6" Background="#2563EB" Foreground="#FFFFFF"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnMyReservations_Click"/>
                    <Button x:Name="btnClose" Content="Đóng" Padding="14,6" Background="#475569" Foreground="#FFFFFF"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Facility Filter & List -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,12,0"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Area -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Tìm kiếm Chi nhánh" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                        
                        <TextBlock Text="Thành phố / Tỉnh:" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtFilterCity" Padding="6" Margin="0,2,0,6" FontSize="12" BorderBrush="#CBD5E1"/>

                        <TextBlock Text="Quận / Huyện:" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtFilterDistrict" Padding="6" Margin="0,2,0,6" FontSize="12" BorderBrush="#CBD5E1"/>

                        <TextBlock Text="Từ khóa (Tên, Mã, Địa chỉ):" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtFilterSearch" Padding="6" Margin="0,2,0,8" FontSize="12" BorderBrush="#CBD5E1"/>

                        <Button x:Name="btnSearchFacilities" Content="🔍 Lọc Cơ Sở" Height="32" Background="#2563EB"
                                Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnSearchFacilities_Click"/>
                    </StackPanel>

                    <!-- Facility List -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="lstFacilities" BorderThickness="0" SelectionChanged="LstFacilities_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                                            Padding="10" Margin="0,3" Cursor="Hand">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#1E293B" FontSize="13" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="{Binding Code}" Foreground="#15803D" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding FullAddress}" Foreground="#64748B" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding OperatingHoursDisplay, StringFormat='Giờ mở cửa: {0}'}" Foreground="#0284C7" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Loading Indicator for facilities -->
                        <TextBlock x:Name="lblFacilityLoading" Text="Đang tải danh sách cơ sở..." HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#64748B" FontSize="13" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Facility Pagination -->
                    <Border Grid.Row="2" Padding="0,8,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnFacilityPrev" Grid.Column="0" Content="◀ Trước" Padding="8,4" Background="#E2E8F0"
                                    BorderThickness="0" Cursor="Hand" Click="BtnFacilityPrev_Click"/>
                            <TextBlock x:Name="lblFacilityPageInfo" Grid.Column="1" Text="Trang 1 / 1" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                            <Button x:Name="btnFacilityNext" Grid.Column="2" Content="Sau ▶" Padding="8,4" Background="#E2E8F0"
                                    BorderThickness="0" Cursor="Hand" Click="BtnFacilityNext_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Panel: Tabs for Unit Types, Available Units, and Floor Map -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="8" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Facility Banner -->
                    <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="txtSelectedFacilityTitle" Text="Vui lòng chọn cơ sở từ danh sách bên trái"
                                           FontSize="15" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock x:Name="txtSelectedFacilityDetails" Text="-" FontSize="12" Foreground="#15803D" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="txtSelectedFacilityTz" Grid.Column="1" Text="Múi giờ: Asia/Ho_Chi_Minh"
                                       FontSize="11" Foreground="#16A34A" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Rental Date & Common Parameters Bar -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Ngày bắt đầu thuê:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <DatePicker x:Name="dpStartDate" Width="130" SelectedDateChanged="DpDates_SelectedDateChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Ngày kết thúc thuê:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <DatePicker x:Name="dpEndDate" Width="130" SelectedDateChanged="DpDates_SelectedDateChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Giá tối đa (đ):" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                <TextBox x:Name="txtFilterMaxPrice" Width="90" Padding="4" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="DT từ (m²):" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,4,0"/>
                                <TextBox x:Name="txtFilterMinArea" Width="50" Padding="4" FontSize="11"/>
                                <TextBlock Text="đến:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="4,0,4,0"/>
                                <TextBox x:Name="txtFilterMaxArea" Width="50" Padding="4" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <CheckBox x:Name="chkFilterClimate" Content="Kho mát có điều hòa" VerticalAlignment="Center" FontSize="11" Foreground="#334155"/>
                            </StackPanel>

                            <Button x:Name="btnApplyDateFilter" Content="Áp dụng lọc" Padding="12,5" Background="#0F766E"
                                    Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand" Click="BtnApplyDateFilter_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- Content Tabs -->
                    <TabControl Grid.Row="2" x:Name="tabCatalog" SelectionChanged="TabCatalog_SelectionChanged" Background="Transparent" BorderThickness="0">
                        
                        <!-- TAB 1: UNIT TYPES & PRICING -->
                        <TabItem Header="🏷️ Loại kho &amp; Biểu phí">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                    <TextBlock Text="📌 Quy tắc BR-RSV-03: Khách hàng chọn đặt chỗ theo Loại kho &amp; Diện tích. Giá niêm yết áp dụng theo facility_rates tại ngày bắt đầu thuê. Số ô khả dụng mang tính chất tham khảo tại thời điểm tra cứu."
                                               FontSize="11" Foreground="#92400E" TextWrapping="Wrap"/>
                                </Border>

                                <DataGrid x:Name="gridUnitTypes" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                                          BorderThickness="1" BorderBrush="#E2E8F0" SelectionMode="Single"
                                          SelectionChanged="GridUnitTypes_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Loại" Binding="{Binding Code}" Width="90"/>
                                        <DataGridTextColumn Header="Tên Loại Kho" Binding="{Binding Name}" Width="150"/>
                                        <DataGridTextColumn Header="Kích Thước (R x D x C)" Binding="{Binding DimensionsDisplay}" Width="190"/>
                                        <DataGridTextColumn Header="Loại Kho" Binding="{Binding ClimateControlDisplay}" Width="140"/>
                                        <DataGridTextColumn Header="Giá Thuê / Tháng" Binding="{Binding MonthlyRateDisplay}" Width="130"/>
                                        <DataGridTextColumn Header="Tiền Cọc (100%)" Binding="{Binding DepositDisplay}" Width="120"/>
                                        <DataGridTextColumn Header="Ô Khả Dụng (Tham Khảo)" Binding="{Binding EstimatedAvailableUnits}" Width="160"/>
                                        <DataGridTextColumn Header="Tổng Ô Niêm Yết" Binding="{Binding TotalListedUnits}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Unit Type Action Footer -->
                                <Border Grid.Row="2" Background="#F8FAFC" Padding="12,10" Margin="0,10,0,0" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="lblSelectedTypeSummary" Text="Chưa chọn loại kho nào." FontWeight="SemiBold" Foreground="#1E293B" FontSize="12"/>
                                            <TextBlock Text="Nút tiếp tục sẽ chuyển tiếp thông tin FacilityId, UnitTypeId và thời hạn thuê sang bước Đặt Chỗ (Chức năng 3)." Foreground="#64748B" FontSize="11"/>
                                        </StackPanel>
                                        <Button x:Name="btnProceedWithType" Grid.Column="1" Content="Tiếp tục chọn loại kho này (Chức năng 3) ➜"
                                                Padding="16,8" Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                                BorderThickness="0" Cursor="Hand" Click="BtnProceedWithType_Click" IsEnabled="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 2: AVAILABLE STORAGE UNITS LIST -->
                        <TabItem Header="📦 Danh sách Ô kho Khả dụng">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                    <TextBlock Text="🛡️ Tuân thủ BR-OPS-02 &amp; BR-RSV-03: Danh sách hiển thị các ô kho vật lý sẵn sàng (Available) thuộc những loại kho còn sức chứa nhận đặt. Số ô ở đây là số ô ứng viên để bàn giao khi check-in; số lượt còn nhận đặt chỗ được quản lý theo từng Loại Kho tại Tab 1."
                                               FontSize="11" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                </Border>

                                <DataGrid x:Name="gridAvailableUnits" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                                          BorderThickness="1" BorderBrush="#E2E8F0" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mã Ô Kho" Binding="{Binding UnitCode}" Width="100"/>
                                        <DataGridTextColumn Header="Loại Kho" Binding="{Binding UnitTypeName}" Width="160"/>
                                        <DataGridTextColumn Header="Vị Trí (Tầng - Khu)" Binding="{Binding LocationDisplay}" Width="140"/>
                                        <DataGridTextColumn Header="Khu Vực (Area)" Binding="{Binding AreaName}" Width="130"/>
                                        <DataGridTextColumn Header="Kích Thước" Binding="{Binding DimensionsDisplay}" Width="140"/>
                                        <DataGridTextColumn Header="Giá Niêm Yết" Binding="{Binding PriceDisplay}" Width="120"/>
                                        <DataGridTextColumn Header="Trạng Thái Sơ Đồ" Binding="{Binding MapStatusDisplay}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Available Units Pagination -->
                                <Border Grid.Row="2" Padding="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnUnitPrev" Grid.Column="0" Content="◀ Trang trước" Padding="10,5" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnUnitPrev_Click"/>
                                        <TextBlock x:Name="lblUnitPageInfo" Grid.Column="1" Text="Trang 1 / 1 (0 ô trống ứng viên)" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11" Foreground="#64748B"/>
                                        <Button x:Name="btnUnitNext" Grid.Column="2" Content="Trang sau ▶" Padding="10,5" Background="#E2E8F0" BorderThickness="0" Cursor="Hand" Click="BtnUnitNext_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- TAB 3: INTERACTIVE FLOOR MAP -->
                        <TabItem Header="🗺️ Sơ đồ Mặt bằng (Floor Map)">
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Floor Map Controls & Legend -->
                                <Border Grid.Row="0" Background="#F8FAFC" Padding="10,8" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Khu vực / Tầng:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="cboMapArea" Grid.Column="1" Width="180" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboMapArea_SelectionChanged"/>

                                        <!-- Legend -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <Rectangle Width="14" Height="14" Fill="#10B981" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Trống (Khả dụng)" FontSize="11" Foreground="#334155" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                            <Rectangle Width="14" Height="14" Fill="#EF4444" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Đang thuê" FontSize="11" Foreground="#334155" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                            <Rectangle Width="14" Height="14" Fill="#F59E0B" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Đang giữ chỗ" FontSize="11" Foreground="#334155" Margin="0,0,12,0" VerticalAlignment="Center"/>

                                            <Rectangle Width="14" Height="14" Fill="#64748B" RadiusX="2" RadiusY="2" Margin="0,0,4,0"/>
                                            <TextBlock Text="Bảo trì / Khóa" FontSize="11" Foreground="#334155" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock x:Name="lblMapUnplacedCount" Grid.Column="3" Text="Ô chưa định vị: 0" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Canvas Floor Map Viewer -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Canvas x:Name="canvasFloorMap" Width="1200" Height="800" Background="#1E293B"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Selected Unit on Map Details & Proceed Action -->
                                <Border Grid.Row="2" Background="#F8FAFC" Padding="12,8" Margin="0,8,0,0" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="lblMapSelectionTitle" Text="Click vào một ô trên sơ đồ để xem thông tin chi tiết." FontWeight="Bold" Foreground="#1E293B" FontSize="12"/>
                                            <TextBlock x:Name="lblMapSelectionDesc" Text="Theo quy tắc BR-RSV-03: Ô trên sơ đồ dùng để tham khảo vị trí và loại kho; nút đặt chỗ sẽ ghi nhận theo Loại Kho." Foreground="#64748B" FontSize="11"/>
                                        </StackPanel>
                                        <Button x:Name="btnProceedFromMap" Grid.Column="1" Content="Tiếp tục chọn loại kho này (Chức năng 3) ➜"
                                                Padding="14,6" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"
                                                BorderThickness="0" Cursor="Hand" Click="BtnProceedFromMap_Click" IsEnabled="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Empty state overlay if no facility selected -->
                    <Border x:Name="panelNoFacility" Grid.Row="2" Background="#FFFFFF" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Vui lòng chọn một cơ sở kho từ danh sách bên trái để bắt đầu tra cứu."
                                       FontSize="14" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Hệ thống sẽ tải danh mục loại kho, giá niêm yết và sơ đồ vị trí ô kho tương ứng."
                                       FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="2" Background="#F1F5F9" Padding="16,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblStatusMessage" Grid.Column="0" Text="Sẵn sàng." Foreground="#475569" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="PRN222 - Final Project | Chức năng 2 Catalog &amp; Map" Foreground="#94A3B8" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
