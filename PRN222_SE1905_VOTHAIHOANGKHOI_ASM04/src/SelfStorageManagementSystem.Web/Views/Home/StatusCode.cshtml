@model SelfStorageManagementSystem.Web.Controllers.ErrorViewModel
@{
    var title = Model.StatusCode switch
    {
        404 => "404 - Không Tìm Thấy Trang",
        403 => "403 - Từ Chối Truy Cập",
        401 => "401 - Yêu Cầu Xác Thực",
        _ => $"Mã trạng thái {Model.StatusCode}"
    };
    ViewData["Title"] = title;
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card shadow border-0 rounded-3">
            <div class="card-body p-5">
                <div class="display-1 fw-bold mb-3 @(Model.StatusCode == 404 ? "text-warning" : Model.StatusCode == 403 ? "text-danger" : "text-secondary")">
                    @if (Model.StatusCode == 404)
                    {
                        <span>&#9888; 404</span>
                    }
                    else if (Model.StatusCode == 403)
                    {
                        <span>&#128683; 403</span>
                    }
                    else
                    {
                        <span>@Model.StatusCode</span>
                    }
                </div>

                <h3 class="fw-bold mb-2">Thông Báo Trạng Thái</h3>

                @if (Model.StatusCode == 404)
                {
                    <h5 class="text-secondary mb-3">Không Tìm Thấy Trang (Not Found)</h5>
                    <p class="text-muted mb-4 lead">
                        Trang hoặc tài nguyên bạn đang tìm kiếm không tồn tại, đã bị xóa hoặc đường dẫn đã thay đổi.
                    </p>
                }
                else if (Model.StatusCode == 403)
                {
                    <h5 class="text-danger mb-3">Từ Chối Quyền Truy Cập (Forbidden)</h5>
                    <p class="text-muted mb-4 lead">
                        Bạn không có quyền truy cập vào chức năng này hoặc tài khoản của bạn chưa được phân công quản lý cơ sở tương ứng.
                    </p>
                }
                else if (Model.StatusCode == 401)
                {
                    <h5 class="text-primary mb-3">Yêu Cầu Đăng Nhập (Unauthorized)</h5>
                    <p class="text-muted mb-4 lead">
                        Phiên làm việc của bạn đã hết hạn hoặc bạn cần đăng nhập để truy cập tài nguyên này.
                    </p>
                }
                else
                {
                    <p class="text-muted mb-4 lead">@Model.Message</p>
                }

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border small text-muted d-inline-block text-start mb-4 py-2 px-3">
                        <strong>Mã sự cố (Request ID):</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                        &larr; Quay về Trang chủ
                    </a>
                    @if (Model.StatusCode == 401 || Model.StatusCode == 403)
                    {
                        <a href="/Account/Login" class="btn btn-outline-secondary px-4">
                            Đăng nhập tài khoản khác
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
