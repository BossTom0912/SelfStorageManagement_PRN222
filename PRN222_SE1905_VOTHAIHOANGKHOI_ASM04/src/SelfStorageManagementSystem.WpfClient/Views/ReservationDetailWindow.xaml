<Window x:Class="SelfStorageManagementSystem.WpfClient.Views.ReservationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chi Tiết Đơn Đặt Chỗ - Self-Storage System" Height="700" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MÃ ĐƠN ĐẶT CHỖ:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtHeaderCode" Text="RES-..." Foreground="#38BDF8" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="txtCustomerInfo" Text="Khách hàng: -" Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border x:Name="badgeStatus" Grid.Column="1" Background="#D97706" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                    <TextBlock x:Name="lblStatusText" Text="Đang giữ chỗ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- Countdown Panel (BR-RSV-01) -->
        <Border x:Name="panelCountdown" Grid.Row="1" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="⏱️ THỜI GIAN KHÓA GIỮ SỨC CHỨA TẠM THỜI (TỐI ĐA 15 PHÚT - BR-RSV-01)" FontWeight="Bold" Foreground="#92400E" FontSize="12"/>
                    <TextBlock x:Name="lblCountdownDesc" Text="Vui lòng hoàn tất thanh toán trước khi thời gian giữ chỗ kết thúc. Quá hạn, hệ thống tự động hủy đơn và nhả sức chứa về trạng thái trống."
                               Foreground="#B45309" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblHoldUntilDeadline" Text="Hạn chót: -" Foreground="#78350F" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Big Countdown Display -->
                <Border Grid.Column="1" Background="#92400E" CornerRadius="8" Padding="16,8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="txtCountdownTimer" Text="15:00" Foreground="#FFFFFF" FontSize="28" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Details Scroll -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Two Column Section -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Location & Unit Type -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="🏢 Thông tin Cơ sở &amp; Loại Kho" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <TextBlock Text="Cơ sở kho:" Foreground="#64748B" FontSize="11"/>
                            <TextBlock x:Name="txtFacilityName" Text="-" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>

                            <TextBlock Text="Địa chỉ cơ sở:" Foreground="#64748B" FontSize="11"/>
                            <TextBlock x:Name="txtFacilityAddress" Text="-" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <TextBlock Text="Loại kho đã đặt (BR-RSV-03):" Foreground="#64748B" FontSize="11"/>
                            <TextBlock x:Name="txtUnitTypeName" Text="-" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,8"/>

                            <TextBlock Text="Thời hạn thuê (BR-RSV-02):" Foreground="#64748B" FontSize="11"/>
                            <TextBlock x:Name="txtRentalDates" Text="-" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Right Column: Financial Breakdown -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Text="💰 Biểu phí &amp; Tiền cọc (Snapshot)" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Giá thuê tháng niêm yết:" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" x:Name="txtMonthlyRate" Text="-" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tiền cọc (100% 1 tháng - BR-FIN-01):" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" x:Name="txtDepositAmount" Text="-" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Phí đặt chỗ ban đầu:" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" x:Name="txtBookingFee" Text="-" Foreground="#64748B"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ưu đãi giảm giá:" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" x:Name="txtDiscount" Text="-" Foreground="#64748B"/>
                            </Grid>

                            <Border Background="#F1F5F9" Height="1" Margin="0,8"/>

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tổng tiền kỳ đầu (Quoted Total):" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Grid.Column="1" x:Name="txtQuotedTotal" Text="-" FontWeight="Bold" FontSize="16" Foreground="#059669"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Policy Banner -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="📋 Quy định Nghiệp vụ (SRS Rules):" FontWeight="Bold" Foreground="#334155" FontSize="12"/>
                            <TextBlock x:Name="txtPolicyNote" Text="Theo quy định BR-RSV-03: Đơn đặt chỗ giữ chỗ theo Loại Kho. Ô cụ thể sẽ được phân công khi check-in tại quầy."
                                       Foreground="#64748B" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Cancellation Info (if cancelled) -->
                    <Border x:Name="panelCancelInfo" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Đơn đã bị hủy" FontWeight="Bold" Foreground="#991B1B" FontSize="12"/>
                            <TextBlock x:Name="txtCancellationDetails" Text="-" Foreground="#7F1D1D" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="lblStatusMessage" Grid.Column="0" Text="" Foreground="#64748B" VerticalAlignment="Center" FontSize="12"/>

            <Button x:Name="btnRefresh" Grid.Column="1" Content="🔄 Làm mới" Padding="14,8" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnRefresh_Click"/>
            <Button x:Name="btnProceedPayment" Grid.Column="2" Content="💳 Thanh toán ngay (Function 4)" Padding="18,8" Background="#10B981" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnProceedPayment_Click"/>
            <Button x:Name="btnCancelReservation" Grid.Column="3" Content="❌ Hủy giữ chỗ" Padding="16,8" Background="#EF4444" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancelReservation_Click"/>
            <Button x:Name="btnClose" Grid.Column="4" Content="Đóng" Padding="20,8" Background="#64748B" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
