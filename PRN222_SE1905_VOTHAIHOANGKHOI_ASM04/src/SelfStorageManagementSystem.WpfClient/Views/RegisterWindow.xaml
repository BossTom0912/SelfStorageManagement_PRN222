<Window x:Class="SelfStorageManagementSystem.WpfClient.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Registration" Height="640" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <StackPanel>
                <TextBlock Text="Customer Registration" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,4"/>
                <TextBlock Text="Create a new customer account to rent storage units" FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                <TextBlock Text="Full Name (*):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="txtFullName" Padding="6" FontSize="13" Margin="0,0,0,10"/>

                <TextBlock Text="Email Address (*):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="txtEmail" Padding="6" FontSize="13" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Password (*):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtPassword" Padding="6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirm Password (*):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="txtConfirmPassword" Padding="6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Phone Number:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtPhone" Padding="6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Identity/Passport No:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtIdentity" Padding="6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Address:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                <TextBox x:Name="txtAddress" Padding="6" FontSize="13" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Emergency Contact:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmergencyName" Padding="6" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Emergency Phone:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtEmergencyPhone" Padding="6" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- Status / Error message -->
                <TextBlock x:Name="lblMessage" Text="" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="Medium"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Register" Height="36" Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Cursor="Hand" Click="BtnRegister_Click"/>
                    <Button Grid.Column="2" Content="Cancel" Height="36" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="BtnCancel_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
