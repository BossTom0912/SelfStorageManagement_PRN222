<Window x:Class="SelfStorageManagementSystem.WpfClient.Views.AssignFacilityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Facility" Height="420" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Assign Facility to Staff/Manager" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
            <TextBlock x:Name="lblEmployeeInfo" Text="Employee: " FontSize="12" Foreground="#64748B" Margin="0,0,0,14"/>

            <TextBlock Text="Target Facility (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbFacility" DisplayMemberPath="DisplayText" SelectedValuePath="Id" Padding="6" Margin="0,0,0,10"/>

            <TextBlock Text="Assignment Role (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
            <ComboBox x:Name="cmbAssignmentRole" SelectedIndex="0" Padding="6" Margin="0,0,0,10">
                <ComboBoxItem Content="facility_staff"/>
                <ComboBoxItem Content="facility_manager"/>
            </ComboBox>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Starts At (*):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpStartsAt" Padding="4"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ends At (Optional):" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpEndsAt" Padding="4"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="lblMessage" Text="" Foreground="#DC2626" FontSize="12" Margin="0,0,0,10"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Confirm Assignment" Height="36" Background="#0D9488" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnAssign_Click"/>
                <Button Grid.Column="2" Content="Cancel" Height="36" Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" Click="BtnCancel_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
