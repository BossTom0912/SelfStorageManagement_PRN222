@page "/Invoices/Details/{id:long?}"
@model SelfStorageManagementSystem.Web.Pages.Invoices.DetailsModel
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = Model.Invoice != null
        ? $"Hóa Đơn {Model.Invoice.InvoiceNo}"
        : "Chi Tiết Hóa Đơn";
    var inv = Model.Invoice;
}

<div class="container py-3">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3 d-print-none">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Invoices">Hóa đơn</a></li>
            <li class="breadcrumb-item active" aria-current="page">@(inv?.InvoiceNo ?? "Chi tiết hóa đơn")</li>
        </ol>
    </nav>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-danger">&#9888;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <div class="mt-2">
                <a href="/Invoices" class="btn btn-outline-secondary btn-sm">Quay về danh sách hóa đơn</a>
            </div>
        </div>
    }
    else if (inv != null)
    {
        <div class="card shadow-sm border-0 mb-4 bg-white" id="invoicePrintArea">
            <div class="card-body p-4 p-md-5">
                <!-- Header hóa đơn -->
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 border-bottom pb-4 mb-4">
                    <div>
                        <div class="text-uppercase small fw-bold text-primary mb-1">Chi Tiết Hóa Đơn</div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="brand-title fs-3 fw-bold text-dark">SelfStorage</span>
                            <span class="brand-accent fs-3 fw-bold text-primary">PRN222</span>
                        </div>
                        <div class="text-muted small">Hệ thống quản lý dịch vụ kho lưu trữ tự quản</div>
                        <div class="text-muted small">Hotline: 1900-PRN222 &bull; Email: support@selfstorage.vn</div>
                    </div>

                    <div class="text-md-end">
                        <div class="d-flex align-items-center justify-content-md-end gap-2 mb-1">
                            <h2 class="h4 fw-bold font-monospace mb-0 text-dark">@inv.InvoiceNo</h2>
                            @{
                                var statusClass = inv.Status switch
                                {
                                    "paid" => "badge bg-success",
                                    "open" => "badge bg-warning text-dark",
                                    "voided" => "badge bg-secondary",
                                    _ => "badge bg-info text-dark"
                                };
                            }
                            <span class="@statusClass px-3 py-1 fs-6">@inv.Status.ToUpper()</span>
                        </div>
                        <div class="small text-muted">
                            Mã hóa đơn nội bộ: <span class="font-monospace">#@inv.InvoiceId</span>
                        </div>
                        <div class="small text-muted">
                            Ngày phát hành: <strong>@AppFormatters.FormatDate(inv.IssueDate)</strong>
                        </div>
                    </div>
                </div>

                <!-- Thông tin khách hàng & Tham chiếu -->
                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2">Khách Hàng / Đơn Vị Thuê:</h6>
                        <div class="fs-5 fw-bold text-dark mb-1">@inv.CustomerName</div>
                        <div class="small text-muted">Mã khách hàng: <span class="font-monospace">#@inv.CustomerId</span></div>
                        <div class="small text-muted">Kỳ thanh toán: @(inv.BillingPeriod ?? "Kỳ đầu (Cọc & Tháng đầu)")</div>
                    </div>

                    <div class="col-sm-6 text-sm-end">
                        <h6 class="fw-bold text-muted text-uppercase small mb-2">Hồ Sơ Tham Chiếu:</h6>
                        @if (inv.ReservationId.HasValue)
                        {
                            <div class="small mb-1">
                                Đơn đặt chỗ:
                                <a href="/Reservations/Details/@inv.ReservationId" class="badge bg-secondary font-monospace text-decoration-none">
                                    @inv.ReservationCode
                                </a>
                            </div>
                        }
                        @if (inv.AgreementId.HasValue && inv.AgreementId.Value > 0)
                        {
                            <div class="small mb-1">
                                Hợp đồng thuê:
                                <a href="/Agreements/Details?id=@inv.AgreementId" class="badge bg-success font-monospace text-decoration-none">
                                    @(inv.AgreementNo ?? $"#{inv.AgreementId}")
                                </a>
                            </div>
                        }
                        <div class="small text-muted">
                            Hạn thanh toán: @AppFormatters.FormatDate(inv.DueDate)
                        </div>
                    </div>
                </div>

                <!-- Bảng chi tiết các dòng hóa đơn (Line Items) -->
                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">#</th>
                                <th>Khoản mục chi phí</th>
                                <th>Phân loại</th>
                                <th class="text-center" style="width: 90px;">SL</th>
                                <th class="text-end" style="width: 160px;">Đơn giá</th>
                                <th class="text-end" style="width: 180px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var lineNo = 1; }
                            @foreach (var line in inv.Lines)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(lineNo++)</td>
                                    <td class="fw-semibold text-dark">@line.Description</td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace small">@line.LineType</span>
                                    </td>
                                    <td class="text-center">@line.Quantity.ToString("0.##")</td>
                                    <td class="text-end font-monospace">@AppFormatters.FormatVnd(line.UnitPrice)</td>
                                    <td class="text-end font-monospace fw-bold">@AppFormatters.FormatVnd(line.LineAmount)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="5" class="text-end text-muted">Cộng tiền dịch vụ (Subtotal):</td>
                                <td class="text-end font-monospace fw-semibold">@AppFormatters.FormatVnd(inv.SubtotalAmount)</td>
                            </tr>
                            @if (inv.DiscountAmount > 0)
                            {
                                <tr class="text-success">
                                    <td colspan="5" class="text-end">Chiết khấu / Ưu đãi giảm giá:</td>
                                    <td class="text-end font-monospace fw-semibold">-@AppFormatters.FormatVnd(inv.DiscountAmount)</td>
                                </tr>
                            }
                            <tr>
                                <td colspan="5" class="text-end text-muted">Thuế GTGT (VAT 0% - Đồ án demo PRN222):</td>
                                <td class="text-end font-monospace">@AppFormatters.FormatVnd(inv.TaxAmount)</td>
                            </tr>
                            <tr class="table-light">
                                <td colspan="5" class="text-end fs-6 fw-bold text-dark">Tổng cộng thanh toán:</td>
                                <td class="text-end fs-5 fw-bold text-primary font-monospace">@AppFormatters.FormatVnd(inv.TotalAmount)</td>
                            </tr>
                            <tr class="table-success">
                                <td colspan="5" class="text-end fw-bold text-success">Đã thanh toán (Paid Amount):</td>
                                <td class="text-end fs-5 fw-bold text-success font-monospace">@AppFormatters.FormatVnd(inv.PaidAmount)</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <!-- Lưu ý chuẩn học phần PRN222 -->
                <div class="alert alert-light border small text-muted mb-4">
                    <strong>📌 Ghi chú:</strong> @inv.Notice
                </div>

                <!-- Thao tác -->
                <div class="d-flex justify-content-between align-items-center d-print-none pt-3 border-top">
                    <a href="/Invoices" class="btn btn-outline-secondary btn-sm">
                        &larr; Danh sách hóa đơn
                    </a>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print();">
                            🖨 In biên nhận / hóa đơn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
