@model SelfStorageManagementSystem.Web.Models.StorageUnitDeleteViewModel
@{
    ViewData["Title"] = Model.StorageUnit != null ? $"Xóa ô kho {Model.StorageUnit.UnitCode}" : "Xác nhận xóa ô kho";
}

<div class="container py-3" style="max-width: 800px;">
    <!-- Breadcrumb điều hướng -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="StorageUnits" asp-action="Index">Quản trị ô kho</a></li>
            @if (Model.StorageUnit != null)
            {
                <li class="breadcrumb-item"><a asp-controller="StorageUnits" asp-action="Details" asp-route-id="@Model.Id">@Model.StorageUnit.UnitCode</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h1 class="h3 mb-1 fw-bold text-danger">Xác Nhận Xóa Ô Kho</h1>
        <p class="text-muted mb-0 small">
            Kiểm tra toàn diện trước khi xóa ô kho vật lý khỏi hệ thống quản lý (MVC View).
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>
                    <strong>Không thể xóa ô kho:</strong> @Model.ErrorMessage
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (!Model.CanManage)
    {
        <div class="alert alert-warning shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-warning fw-bold">&#9888;</span>
                <div>
                    <strong>Chế độ xem:</strong> Vai trò nhân viên cơ sở (Facility Staff) không có thẩm quyền xóa ô kho. Thao tác này yêu cầu quyền <strong>Quản lý cơ sở (Facility Manager)</strong> hoặc <strong>Quản trị viên (Administrator)</strong>.
                </div>
            </div>
        </div>
    }

    @if (!Model.CanDelete)
    {
        <div class="alert alert-danger shadow-sm mb-4 border-danger" role="alert">
            <div class="d-flex align-items-start">
                <span class="me-3 fs-4 text-danger">&#9888;</span>
                <div>
                    <h6 class="alert-heading fw-bold mb-1">Ràng buộc chính sách & tham chiếu: Không thể xóa ô kho này</h6>
                    <p class="mb-0 small">
                        @Model.BlockReason
                    </p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-warning fw-bold">&#9888;</span>
                <div>
                    @if (Model.StorageUnit != null && (Model.StorageUnit.AllocationsCount > 0 || Model.StorageUnit.InspectionsCount > 0 || Model.StorageUnit.MaintenanceOrdersCount > 0 || Model.StorageUnit.SupportTicketsCount > 0))
                    {
                        <text><strong>Cảnh báo:</strong> Ô kho <strong>@Model.StorageUnit.UnitCode</strong> có dữ liệu liên kết. Xác nhận sẽ giữ bản ghi và chuyển sang trạng thái ngừng niêm yết.</text>
                    }
                    else
                    {
                        <text><strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa vĩnh viễn ô kho <strong>@(Model.StorageUnit?.UnitCode)</strong> không? Thao tác này không thể hoàn tác.</text>
                    }
                </div>
            </div>
        </div>
    }

    @if (Model.StorageUnit != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-semibold text-secondary">Chi Tiết Bản Ghi Sắp Xóa</h5>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 gy-3">
                    <dt class="col-sm-4 text-secondary small fw-bold">Mã ô kho:</dt>
                    <dd class="col-sm-8 fw-bold font-monospace text-primary fs-5">@Model.StorageUnit.UnitCode</dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Cơ sở lưu trữ:</dt>
                    <dd class="col-sm-8">
                        <div>@Model.StorageUnit.FacilityName</div>
                        <div class="small text-muted font-monospace">@Model.StorageUnit.FacilityCode (ID: @Model.StorageUnit.FacilityId)</div>
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Loại ô kho:</dt>
                    <dd class="col-sm-8">
                        <div>@Model.StorageUnit.UnitTypeName</div>
                        <div class="small text-muted font-monospace">@Model.StorageUnit.UnitTypeCode</div>
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Trạng thái hiện tại:</dt>
                    <dd class="col-sm-8 font-monospace">@Model.StorageUnit.PhysicalStatus</dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Khu vực / Tầng:</dt>
                    <dd class="col-sm-8">
                        @(Model.StorageUnit.AreaName ?? "Không chỉ định") &bull; @(Model.StorageUnit.FloorLabel ?? "Chưa rõ tầng")
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Số lượt hợp đồng liên kết:</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.StorageUnit.AllocationsCount > 0 ? "bg-danger" : "bg-success")">
                            @Model.StorageUnit.AllocationsCount lượt gán hợp đồng
                        </span>
                    </dd>

                    <dt class="col-sm-4 text-secondary small fw-bold">Lần cập nhật cuối:</dt>
                    <dd class="col-sm-8 font-monospace text-muted small">
                        @Model.StorageUnit.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss.fff zzz")
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-controller="StorageUnits" asp-action="Delete" asp-route-id="@Model.Id" method="post" id="deleteStorageUnitForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExpectedUpdatedAt" value="@Model.ExpectedUpdatedAt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffffffZ")" id="inputExpectedUpdatedAt" />

            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="StorageUnits" asp-action="Index" class="btn btn-outline-secondary px-4">
                    &larr; Không xóa, quay lại
                </a>

                @if (Model.CanDelete && Model.CanManage)
                {
                    <button type="submit" class="btn btn-danger px-4 fw-semibold" id="btnSubmitDelete">
                        Xác Nhận Xóa Vĩnh Viễn
                    </button>
                }
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentUnitId = @Model.Id;

            if (typeof signalR !== 'undefined') {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/storageUnitHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("Receiver_UpdateStorageUnit", function (item) {
                    if (item && item.id === currentUnitId) {
                        alert("Ô kho này vừa được cập nhật trên hệ thống bởi một người dùng khác. Trang sẽ tự động tải lại để đối chiếu dữ liệu mới nhất.");
                        window.location.reload();
                    }
                });

                connection.on("Receiver_DeleteStorageUnit", function (deletedId) {
                    if (deletedId == currentUnitId) {
                        alert("Ô kho này đã được xóa thành công bởi một người dùng khác.");
                        window.location.href = "/StorageUnits";
                    }
                });

                connection.start().catch(err => console.error("SignalR Connection Error:", err.toString()));
            }
        });
    </script>
}
