@page "/Admin/Accounts/Details"
@model SelfStorageManagementSystem.Web.Pages.Admin.Accounts.DetailsModel
@using SelfStorageManagementSystem.BusinessLogic.Common.Constants
@using SelfStorageManagementSystem.Web.Helpers
@{
    ViewData["Title"] = $"Chi Tiết Tài Khoản #{Model.Account?.Id}";
    var acc = Model.Account;
    var nowUtc = DateTimeOffset.UtcNow;
}

<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-page="./Index">Quản trị tài khoản</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết tài khoản #@(acc?.Id)</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Chi Tiết Tài Khoản #@(acc?.Id)</h1>
            <p class="text-muted mb-0 small">@(acc?.Email) - Hồ sơ định danh và phân công cơ sở</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary">
                &larr; Danh sách tài khoản
            </a>
            <a asp-page="./Details" asp-route-id="@acc?.Id" class="btn btn-outline-primary">
                <span>&#8635;</span> Tải lại
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-success fw-bold">&#10004;</span>
                <div>@Model.SuccessMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center">
                <span class="me-2 fs-5 text-danger fw-bold">&#10008;</span>
                <div>@Model.ErrorMessage</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (acc != null)
    {
        <div class="row g-4">
            <!-- Cột trái: Thông tin tài khoản & Hồ sơ & Đổi trạng thái -->
            <div class="col-lg-5">
                <!-- Thẻ Thông tin tài khoản -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-semibold text-secondary">
                            Thông Tin Đăng Nhập
                        </h5>
                        @if (acc.Status == "active")
                        {
                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Hoạt động</span>
                        }
                        else if (acc.Status == "locked")
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">Đã khóa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Vô hiệu hóa</span>
                        }
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-muted small">Mã định danh (ID):</dt>
                            <dd class="col-sm-7 fw-bold">#@acc.Id</dd>

                            <dt class="col-sm-5 text-muted small">Địa chỉ Email:</dt>
                            <dd class="col-sm-7 fw-semibold">@acc.Email</dd>

                            <dt class="col-sm-5 text-muted small">Số điện thoại:</dt>
                            <dd class="col-sm-7">@(acc.PhoneNumber ?? "—")</dd>

                            <dt class="col-sm-5 text-muted small">Ngày đăng ký:</dt>
                            <dd class="col-sm-7">@AppFormatters.FormatDateTime(acc.CreatedAt)</dd>

                            <dt class="col-sm-5 text-muted small">Đăng nhập cuối:</dt>
                            <dd class="col-sm-7">@AppFormatters.FormatDateTime(acc.LastLoginAt)</dd>
                        </dl>
                    </div>
                </div>

                <!-- Thẻ Hồ sơ nhân sự / Khách hàng -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title mb-0 fw-semibold text-secondary">
                            Hồ Sơ Định Danh
                        </h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5 text-muted small">Họ và tên:</dt>
                            <dd class="col-sm-7 fw-bold">@(acc.FullName ?? "—")</dd>

                            @if (!string.IsNullOrWhiteSpace(acc.EmployeeCode))
                            {
                                <dt class="col-sm-5 text-muted small">Mã nhân viên:</dt>
                                <dd class="col-sm-7"><span class="badge bg-light text-dark border font-monospace">@acc.EmployeeCode</span></dd>

                                <dt class="col-sm-5 text-muted small">Tình trạng nhân sự:</dt>
                                <dd class="col-sm-7">
                                    @if (acc.EmploymentStatus == "active")
                                    {
                                        <span class="badge bg-success">Đang làm việc (active)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@(acc.EmploymentStatus ?? "—")</span>
                                    }
                                </dd>

                                <dt class="col-sm-5 text-muted small">Ngày vào làm:</dt>
                                <dd class="col-sm-7">@AppFormatters.FormatDate(acc.HireDate)</dd>
                            }

                            @if (!string.IsNullOrWhiteSpace(acc.IdentityNumber))
                            {
                                <dt class="col-sm-5 text-muted small">Số CCCD/Hộ chiếu:</dt>
                                <dd class="col-sm-7 font-monospace">@acc.IdentityNumber</dd>
                            }
                        </dl>
                    </div>
                </div>

                <!-- Thẻ Cập nhật trạng thái tài khoản -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title mb-0 fw-semibold text-secondary">
                            Thay Đổi Trạng Thái Tài Khoản
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="UpdateStatus" asp-route-id="@acc.Id" id="formUpdateStatus">
                            <div class="mb-3">
                                <label class="form-label fw-semibold small text-muted">Chọn trạng thái mới</label>
                                <select asp-for="StatusInput.Status" class="form-select" id="selectStatus">
                                    <option value="active">Hoạt động (active)</option>
                                    <option value="locked">Khóa tạm thời (locked)</option>
                                    <option value="disabled">Vô hiệu hóa vĩnh viễn (disabled)</option>
                                </select>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-warning shadow-sm fw-semibold" id="btnUpdateStatus">
                                    Cập Nhật Trạng Thái
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Phân quyền vai trò & Phân công cơ sở -->
            <div class="col-lg-7">
                <!-- Thẻ Quản lý vai trò (Roles) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="card-title mb-0 fw-semibold text-secondary">
                            Quản Lý Vai Trò Hệ Thống (Roles)
                        </h5>
                    </div>
                    <div class="card-body">
                        <form method="post" asp-page-handler="ManageRoles" asp-route-id="@acc.Id" id="formManageRoles">
                            <p class="text-muted small mb-3">
                                Chọn một hoặc nhiều vai trò gán cho tài khoản. Hệ thống áp dụng quy tắc an toàn bảo vệ quản trị viên cuối cùng.
                            </p>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded">
                                        <input class="form-check-input" type="checkbox" name="RolesInput.SelectedRoles"
                                               value="@RoleConstants.SystemAdministrator" id="role_admin"
                                               checked="@(acc.Roles.Contains(RoleConstants.SystemAdministrator))" />
                                        <label class="form-check-label fw-semibold text-danger" for="role_admin">
                                            Quản trị viên (system_administrator)
                                        </label>
                                        <div class="text-muted small">Toàn quyền cấu hình tài khoản và phân quyền</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded">
                                        <input class="form-check-input" type="checkbox" name="RolesInput.SelectedRoles"
                                               value="@RoleConstants.BusinessOperationsManager" id="role_ops"
                                               checked="@(acc.Roles.Contains(RoleConstants.BusinessOperationsManager))" />
                                        <label class="form-check-label fw-semibold text-warning-emphasis" for="role_ops">
                                            Quản lý vận hành (operations)
                                        </label>
                                        <div class="text-muted small">Vận hành kinh doanh, ô kho trên toàn chuỗi</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded">
                                        <input class="form-check-input" type="checkbox" name="RolesInput.SelectedRoles"
                                               value="@RoleConstants.FacilityManager" id="role_manager"
                                               checked="@(acc.Roles.Contains(RoleConstants.FacilityManager))" />
                                        <label class="form-check-label fw-semibold text-info-emphasis" for="role_manager">
                                            Quản lý cơ sở (facility_manager)
                                        </label>
                                        <div class="text-muted small">Quản trị kho, check-in và đối soát tại cơ sở</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check p-3 border rounded">
                                        <input class="form-check-input" type="checkbox" name="RolesInput.SelectedRoles"
                                               value="@RoleConstants.FacilityStaff" id="role_staff"
                                               checked="@(acc.Roles.Contains(RoleConstants.FacilityStaff))" />
                                        <label class="form-check-label fw-semibold text-primary" for="role_staff">
                                            Nhân viên quầy (facility_staff)
                                        </label>
                                        <div class="text-muted small">Thao tác quầy tiếp nhận, bàn giao và kiểm định</div>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-check p-3 border rounded">
                                        <input class="form-check-input" type="checkbox" name="RolesInput.SelectedRoles"
                                               value="@RoleConstants.StorageCustomer" id="role_customer"
                                               checked="@(acc.Roles.Contains(RoleConstants.StorageCustomer))" />
                                        <label class="form-check-label fw-semibold text-secondary" for="role_customer">
                                            Khách hàng thuê kho (storage_customer)
                                        </label>
                                        <div class="text-muted small">Đặt chỗ, xem ô kho đã thuê và nhận thông báo</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button type="submit" class="btn btn-primary shadow-sm fw-semibold" id="btnSaveRoles">
                                    <span class="me-1 fw-bold">&#10004;</span> Lưu Thay Đổi Vai Trò
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Thẻ Phân công cơ sở làm việc (Facility Assignments) -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0 fw-semibold text-secondary">
                            Phân Công Cơ Sở (Staff Facility Assignments)
                        </h5>
                        <span class="badge bg-secondary">@acc.FacilityAssignments.Count phân công</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="assignmentsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Cơ sở kho</th>
                                        <th>Vai trò</th>
                                        <th>Thời gian hiệu lực</th>
                                        <th>Trạng thái</th>
                                        <th class="text-end pe-3">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (acc.FacilityAssignments.Count == 0)
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">
                                                Chưa có phân công cơ sở nào cho nhân sự này.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var assign in acc.FacilityAssignments.OrderByDescending(a => a.StartsAt))
                                        {
                                            var isCurrentActive = assign.StartsAt <= nowUtc && (assign.EndsAt == null || assign.EndsAt > nowUtc);
                                            <tr>
                                                <td class="ps-3">
                                                    <div class="fw-semibold">@assign.FacilityName</div>
                                                    <div class="text-muted small font-monospace">@assign.FacilityCode</div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-dark border">@assign.AssignmentRole</span>
                                                </td>
                                                <td class="small">
                                                    <div>Từ: @AppFormatters.FormatDateTime(assign.StartsAt)</div>
                                                    <div>Đến: @(assign.EndsAt.HasValue ? AppFormatters.FormatDateTime(assign.EndsAt.Value) : "Vô thời hạn")</div>
                                                </td>
                                                <td>
                                                    @if (isCurrentActive)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success">Đang hiệu lực</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border">Đã kết thúc</span>
                                                    }
                                                </td>
                                                <td class="text-end pe-3">
                                                    @if (isCurrentActive)
                                                    {
                                                        <form method="post" asp-page-handler="TerminateAssignment"
                                                              asp-route-id="@acc.Id" asp-route-assignmentId="@assign.Id"
                                                              class="d-inline form-terminate-assignment">
                                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                    title="Chấm dứt hiệu lực phân công này ngay lập tức"
                                                                    onclick="return confirm('Bạn có chắc chắn muốn chấm dứt hiệu lực phân công cơ sở này không?');">
                                                                Chấm dứt
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">—</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Thẻ Phân công cơ sở mới -->
                @if (acc.EmployeeCode != null && (acc.Roles.Contains(RoleConstants.FacilityStaff) || acc.Roles.Contains(RoleConstants.FacilityManager)))
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h6 class="card-title mb-0 fw-semibold text-primary">
                                + Thêm Phân Công Cơ Sở Mới
                            </h6>
                        </div>
                        <div class="card-body">
                            <form method="post" asp-page-handler="AssignFacility" asp-route-id="@acc.Id" id="formAssignFacility">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small text-muted">Chọn cơ sở kho</label> <span class="text-danger">*</span>
                                        <select asp-for="AssignmentInput.FacilityId" class="form-select" id="selectAssignFacility">
                                            <option value="">-- Chọn cơ sở --</option>
                                            @foreach (var fac in Model.Facilities)
                                            {
                                                <option value="@fac.Id">@fac.Name (@fac.Code) - @fac.City</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small text-muted">Vai trò tại cơ sở</label> <span class="text-danger">*</span>
                                        <select asp-for="AssignmentInput.AssignmentRole" class="form-select" id="selectAssignRole">
                                            @if (acc.Roles.Contains(RoleConstants.FacilityStaff))
                                            {
                                                <option value="@RoleConstants.FacilityStaff">Nhân viên quầy (facility_staff)</option>
                                            }
                                            @if (acc.Roles.Contains(RoleConstants.FacilityManager))
                                            {
                                                <option value="@RoleConstants.FacilityManager">Quản lý cơ sở (facility_manager)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small text-muted">Thời điểm bắt đầu</label> <span class="text-danger">*</span>
                                        <input asp-for="AssignmentInput.StartsAt" type="datetime-local" class="form-control"
                                               value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small text-muted">Thời điểm kết thúc (Tùy chọn)</label>
                                        <input asp-for="AssignmentInput.EndsAt" type="datetime-local" class="form-control" />
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-primary shadow-sm fw-semibold" id="btnAssignFacility">
                                        Phân Công Cơ Sở
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/admin-accounts.js" asp-append-version="true"></script>
}
