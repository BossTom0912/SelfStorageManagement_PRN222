@model SelfStorageManagementSystem.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-7 col-xl-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="fs-1 text-primary mb-2">&#128100;</span>
                    <h3 class="fw-bold mb-1">Đăng Ký Khách Hàng Mới</h3>
                    <p class="text-muted small">Tạo tài khoản để đặt chỗ và quản lý ô kho tự quản an toàn</p>
                </div>

                <form asp-action="Register" method="post" id="registerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" value="@returnUrl" />

                    <partial name="_ValidationSummary" />

                    <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">1. Thông tin đăng nhập</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="tenkhachhang@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            <input type="password" asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary mb-3 mt-4 border-bottom pb-2">2. Thông tin cá nhân</h6>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdentityNumber" class="form-label fw-semibold"></label>
                            <input asp-for="IdentityNumber" class="form-control" placeholder="001200000000" />
                            <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold"></label>
                            <input type="date" asp-for="DateOfBirth" class="form-control" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-primary mb-3 mt-4 border-bottom pb-2">3. Người liên hệ khẩn cấp (Không bắt buộc)</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactName" class="form-label fw-semibold"></label>
                            <input asp-for="EmergencyContactName" class="form-control" placeholder="Họ tên người liên hệ" />
                            <span asp-validation-for="EmergencyContactName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmergencyContactPhone" class="form-label fw-semibold"></label>
                            <input asp-for="EmergencyContactPhone" class="form-control" placeholder="0987654321" />
                            <span asp-validation-for="EmergencyContactPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fs-6 py-2 fw-semibold" id="btnRegisterSubmit">
                            Hoàn Tất Đăng Ký
                        </button>
                    </div>

                    <div class="text-center pt-2 border-top">
                        <span class="text-muted small">Đã có tài khoản? </span>
                        <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="fw-semibold text-decoration-none small">
                            Đăng nhập tại đây &rarr;
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
